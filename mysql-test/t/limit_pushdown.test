select * from (select * from t1) x order by 1 limit 2 offset 1;

set optimizer_switch=default;

drop view if exists vt1, vtt1, vt2, vt3;
drop view if exists vt4, vt5, vt5_1, vt6;
drop view if exists vt7, vt8, vt9;
drop view if exists vt10, vt11, vt12;
drop view if exists vt13, vt14, vt15;

drop table if exists t1, t2;

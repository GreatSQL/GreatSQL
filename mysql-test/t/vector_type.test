--source include/elide_costs_and_rows.inc
--source vector.inc

CREATE TABLE ta (pk INT, embedding VECTOR(1), PRIMARY KEY (pk));
INSERT INTO ta VALUES
(0, UNHEX("8679613f")),
(1, UNHEX("71b06a3f")),
(2, UNHEX("95afc03e")),
(3, UNHEX("c620123d")),
(4, UNHEX("b8d58c3d"));

--error ER_FT_MATCHING_KEY_NOT_FOUND
SELECT MATCH (embedding) AGAINST ('abc') FROM ta;
--disable_result_log
--sorted_result
SELECT AES_ENCRYPT(embedding, UNHEX('F3229A0B371ED2D9441B830D21A390C3')) FROM ta;
--enable_result_log
--sorted_result
SELECT COLLATION(embedding), CHARSET(embedding) FROM ta;

DROP TABLE ta;

--error ER_BLOB_CANT_HAVE_DEFAULT
CREATE TABLE t(pk INT, v VECTOR(1) DEFAULT '', PRIMARY KEY(pk));

CREATE TABLE t(pk INT, v VECTOR(1) DEFAULT(''), PRIMARY KEY(pk));
--error ER_DATA_INCOMPATIBLE_WITH_VECTOR
INSERT INTO t(pk) VALUES (1),(2);
DROP TABLE if exists t;

CREATE TABLE t(pk INT, v VECTOR(3) DEFAULT(TO_VECTOR('[1,2,3]')), PRIMARY KEY(pk));
INSERT INTO t(pk) VALUES (1),(2);
--sorted_result
SELECT pk,VECTOR_TO_STRING(v) FROM t;
--error ER_NON_SCALAR_USED_AS_KEY
CREATE INDEX z ON t(v);
--error ER_INCORRECT_TYPE
CREATE INDEX z ON t((v IS NULL));

DROP TABLE t;

CREATE TABLE t(pk INT, v VECTOR(1) DEFAULT(UNHEX('aabbccdd')), PRIMARY KEY(pk));
INSERT INTO t(pk) VALUES (1),(2);
--sorted_result
SELECT pk, hex(v) FROM t;
DROP TABLE t;

CREATE TABLE t(pk INT, v VECTOR(1) DEFAULT(UNHEX('aabbccddee')), PRIMARY KEY(pk));
--error ER_DATA_INCOMPATIBLE_WITH_VECTOR
INSERT INTO t(pk) VALUES (1),(2);
DROP TABLE t;

CREATE TABLE t(pk INT, v VECTOR(1) DEFAULT(UNHEX('aabbccddaabbccdd')), PRIMARY KEY(pk));
--error ER_DATA_TOO_LONG
INSERT INTO t(pk) VALUES (1),(2);
DROP TABLE t;

--error ER_INCORRECT_TYPE
CREATE TABLE t (c1 INT, c2 VECTOR, c3 VECTOR, CHECK (c2 = c3));

CREATE TABLE A(
    a1 INT primary key,
    a2 DOUBLE,
    a3 DATETIME,
    a4 DECIMAL(10,5),
    a5 VARCHAR(10),
    a6 JSON,
    a7 GEOMETRY
);
INSERT INTO A VALUES
(1, 2.0, '2001-02-28 08:40:16', 1.2, 'abcd', '{"k":"v"}', ST_PointFromText('POINT(1 1)'));

--error ER_WRONG_ARGUMENTS
SELECT TO_VECTOR(a1) FROM A;
--error ER_WRONG_ARGUMENTS
SELECT TO_VECTOR(a2) FROM A;
--error ER_TO_VECTOR_CONVERSION
SELECT TO_VECTOR(a3) FROM A;
--error ER_WRONG_ARGUMENTS
SELECT TO_VECTOR(a4) FROM A;
--error ER_TO_VECTOR_CONVERSION
SELECT TO_VECTOR(a5) FROM A;
--error ER_WRONG_ARGUMENTS
SELECT TO_VECTOR(a6) FROM A;
--error ER_WRONG_ARGUMENTS
SELECT TO_VECTOR(a7) FROM A;

DROP TABLE A;

--error ER_TO_VECTOR_CONVERSION
select to_vector('') as r;
select to_vector(null) as r;
select to_vector(null) is null as r;

set @vec = '[1.2,2.3,3.4]';
select to_vector(@vec) as r;
set @vec = '';
--error ER_TO_VECTOR_CONVERSION
select to_vector(@vec) as r;
set @vec = null;
select to_vector(@vec) as r;

--error ER_TO_VECTOR_CONVERSION
select from_vector(to_vector('')) as r;
select from_vector(to_vector(null)) as r;
select from_vector(to_vector(null)) is null as r;

set @vec = '[1.2,2.3,3.4]';
select from_vector(to_vector(@vec)) as r;
set @vec = '';
--error ER_TO_VECTOR_CONVERSION
select from_vector(to_vector(@vec)) as r;
set @vec = null;
select from_vector(to_vector(@vec)) as r;


CREATE TABLE items (id int PRIMARY KEY, embedding vector(3));

INSERT INTO items VALUES (1, to_vector('[1,2,3]'));
INSERT INTO items VALUES (2, to_vector('[4,5]'));
INSERT INTO items VALUES (3, NULL);

SELECT
    FROM_VECTOR(embedding),
    LENGTH(embedding),
    BIT_LENGTH(embedding),
    CHAR_LENGTH(embedding),
    HEX(embedding),
    TO_BASE64(embedding)
FROM items;

SELECT
    HEX(AES_ENCRYPT(embedding, 'X')),
    HEX(COMPRESS(embedding)),
    MD5(embedding),
    SHA1(embedding),
    SHA2(embedding, 8)
FROM items;

select
    FROM_VECTOR(COALESCE(embedding, TO_VECTOR('[1]'))),
    FROM_VECTOR(IFNULL(embedding, TO_VECTOR('[1]'))),
    FROM_VECTOR(NULLIF(embedding, TO_VECTOR('[1]'))),
    IF(embedding IS NULL, 1, 2)
from items;


SELECT COUNT(embedding) FROM items;

CREATE VIEW V_VEC AS
SELECT
    id as id,
    embedding as c1,
    from_vector(embedding) as c2,
    to_vector(from_vector(embedding)) as c3,
    to_vector('[1.1,2.2,3.3]') as c4,
    from_vector(to_vector('[1.1,2.2,3.3]')) as c5,
    to_vector(from_vector(to_vector('[1.1,2.2,3.3]'))) as c6
FROM items ORDER BY id;

SHOW CREATE TABLE V_VEC;

SELECT
    id,
    from_vector(c1),
    to_vector(c2),
    from_vector(c3),
    from_vector(c4),
    to_vector(c5),
    from_vector(c6)
FROM V_VEC ORDER BY id;

CREATE TABLE T_VEC AS
SELECT
    id as id,
    embedding as c1,
    from_vector(embedding) as c2,
    to_vector(from_vector(embedding)) as c3,
    to_vector('[1.1,2.2,3.3]') as c4,
    from_vector(to_vector('[1.1,2.2,3.3]')) as c5,
    to_vector(from_vector(to_vector('[1.1,2.2,3.3]'))) as c6
FROM items ORDER BY id;

SHOW CREATE TABLE T_VEC;

SELECT
    id,
    from_vector(c1),
    to_vector(c2),
    from_vector(c3),
    from_vector(c4),
    to_vector(c5),
    from_vector(c6)
FROM T_VEC ORDER BY id;

SELECT * FROM V_VEC EXCEPT SELECT * FROM T_VEC;

SELECT * FROM V_VEC WHERE c1 = to_vector('[1,2,3]');
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT * FROM V_VEC WHERE c1 = to_vector('[1,2,3]');

DROP VIEW V_VEC;
DROP TABLE T_VEC;
DROP TABLE items;
--source include/have_log_bin.inc

--echo #
--echo # When using the mysqlbinlog tool to specify a database for filtering the binlog,
--echo # rows_query_log_event events from non-specified databases were not filtered out.
--echo #

show variables like 'binlog_format';

reset binary logs and gtids;

create database if not exists test1;
create database if not exists test2;

set session binlog_rows_query_log_events=on;

use test1;
create table t1 (c1 int, c2 int) engine=innodb;
use test2;
create table t2 (c1 int, c2 int) engine=innodb;

insert into test1.t1 values (1,1);
insert into test1.t1 values (2,2);
insert into test1.t1 values (3,3);
insert into test2.t2 values (1,1);
insert into test2.t2 values (2,2);
insert into test2.t2 values (3,3);

let $MYSQLD_DATADIR= `select @@datadir`;
let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1);

flush logs;

--exec $MYSQL_BINLOG --database=test1 $MYSQLD_DATADIR/$binlog_file -vv > $MYSQLTEST_VARDIR/tmp/test1.sql

--let $assert_file= $MYSQLTEST_VARDIR/tmp/test1.sql
--let $assert_select=test2
--let $assert_text= Verify 'test2' is absent in test1.sql.
--let $assert_count=0
--source include/assert_grep.inc

drop database test1;
drop database test2;
reset binary logs and gtids;

--exec $MYSQL test < $MYSQLTEST_VARDIR/tmp/test1.sql
--remove_file $MYSQLTEST_VARDIR/tmp/test1.sql

select * from test1.t1;

drop database test1;

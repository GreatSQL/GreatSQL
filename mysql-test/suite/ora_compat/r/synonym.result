[# bug13253, NVDB-TEMP-CITIVD-2026226423, NVDB-CITIVD-2026530078, too long name cause core]
use test;
create table t1 (c1 int);
create table t2 (c1 int);
insert into t1 values (1024);
create synonym longname__aaaaaaaaa_bbbbbbbbb_ccccccccc_ddddddddd_eeeeeeeee_ok64 for t1;
show create synonym longname__aaaaaaaaa_bbbbbbbbb_ccccccccc_ddddddddd_eeeeeeeee_ok64;

set global synonym_translation_enabled=ON;
create table t(id int primary key auto_increment, val varchar(100) character set utf8mb4 default "你好世界");
create view v as select * from t where id % 2 = 0;
create database another_db;
use another_db;
create table t(id int primary key auto_increment, val varchar(100) character set utf8mb4 default "你好世界");
create view v as select * from t where id % 2 = 0;

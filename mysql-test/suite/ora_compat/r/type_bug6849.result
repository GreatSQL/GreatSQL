#
# test of bug11947
#
create or replace type t_air as object(id int,type varchar(20));
CREATE OR REPLACE TYPE t_air_table AS table OF t_air;
create table t1(id int,name1 varchar(20));
insert into t1 values(1,'aabb');
insert into t1 values(2,'qwed');
insert into t1 values(2,'qwssq');
create table tt_air(id int,air t_air);
insert into tt_air values(1,t_air(1,'aabb'));
insert into tt_air values(2,t_air(2,'qwed'));
create table t2 like t1;
insert into t2 select * from t1;
CREATE or replace PROCEDURE p1() as
rec t1%ROWTYPE;
rec1_row t2%ROWTYPE;
begin
select * from (SELECT rec.id,rec.name1) t1 inner join (SELECT rec1_row.id,rec1_row.name1) t2;
end;
$$
call p1;
id	name1	id	name1
NULL	NULL	NULL	NULL
call p1;
id	name1	id	name1
NULL	NULL	NULL	NULL
drop PROCEDURE p1;
CREATE OR replace PROCEDURE p1() as
type tklist is table of t1%rowtype INDEX BY pls_integer;
tb1 tklist;
begin
tb1(2).id := 100;
tb1(2).name1 := 'bb';
tb1(1).id := 200;
tb1(1).name1 := 'ccc';
select * from (select  tb1(2).id,tb1(2).name1) t1 inner join (SELECT tb1(1).id,tb1(1).name1) t2;
end;
$$
call p1;
id	name1	id	name1
100	bb	200	ccc
call p1;
id	name1	id	name1
100	bb	200	ccc
drop PROCEDURE p1;
CREATE OR replace PROCEDURE p1() as
rec tt_air%ROWTYPE;
rec1_row tt_air%ROWTYPE;
begin
select * from (select rec.id,rec.air) t1 inner join (select rec1_row.id,rec1_row.air) t2;
end;
$$
call p1;
id	air	id	air
NULL	NULL	NULL	NULL
call p1;
id	air	id	air
NULL	NULL	NULL	NULL
drop PROCEDURE p1;

#
# test of BUG11151
#
CREATE TABLE TC10573_tb01 (
id INT AUTO_INCREMENT PRIMARY KEY,
input VARCHAR2(100),
fmt  VARCHAR2(100)
);
INSERT INTO TC10573_tb01 (id,input, fmt) VALUES (1,'1234567',null);
INSERT INTO TC10573_tb01 (id,input, fmt) VALUES (2,'1,234.567','9,999.999');
CREATE OR REPLACE PROCEDURE p1(num int) IS
v_converted  NUMBER;
TYPE t_rec IS TABLE OF TC10573_tb01%ROWTYPE INDEX BY INT;    
rec1 t_rec;
CURSOR c1 IS SELECT * FROM TC10573_tb01;
BEGIN
FOR j in 1 .. num LOOP
OPEN c1;
fetch c1 bulk collect into rec1 ;
for i in rec1.first .. rec1.last loop
v_converted := to_number(rec1(i).input,rec1(i).fmt);
select i,rec1(i).id,v_converted; 
end loop;
CLOSE c1;
end loop;
END ;
$$
call p1(2);
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
call p1(5);
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
i	rec1(i).id	v_converted
1	1	NULL
i	rec1(i).id	v_converted
2	2	1234.567
drop PROCEDURE p1;
#
# test of BUG12857
#
create table t1 like TC10573_tb01;
insert into t1 select * from TC10573_tb01;
create view v1 as select * from (select * from t1 union select * from TC10573_tb01) where id>0;
CREATE or replace procedure p1() as
begin
for i in (select * from t1) loop
select * from v1 where v1.id=i.id;
end loop;
END ;
$$
call p1();
id	input	fmt
1	1234567	NULL
id	input	fmt
2	1,234.567	9,999.999
call p1();
id	input	fmt
1	1234567	NULL
id	input	fmt
2	1,234.567	9,999.999
drop PROCEDURE p1;
#
# test of BUG13562
#
set binlog_format='statement';
Warnings:
Warning	1287	'@@binlog_format' is deprecated and will be removed in a future release.
create or replace type t_air as object(id int,type varchar(20));
#
# test Item_splocal_row_field_by_name
#
CREATE OR REPLACE PROCEDURE p1() AS
v_counter INT := 0;
BEGIN
FOR cur_info IN (SELECT * FROM t1)
LOOP
SELECT * FROM v1 WHERE id = cur_info.id;
END LOOP;
END;
$$
CALL p1();
id	input	fmt
1	1234567	NULL
id	input	fmt
2	1,234.567	9,999.999
CALL p1();
id	input	fmt
1	1234567	NULL
id	input	fmt
2	1,234.567	9,999.999
drop PROCEDURE p1;
#
# test Item_splocal_row_field_table_by_name
#
CREATE OR REPLACE PROCEDURE p1() AS
type t_test1 is record(
id int := 1,
type1 t_air);
stu t_test1;
type tklist is table of t_test1 index by binary_integer;
stu_record_val tklist;
BEGIN
stu := t_test1(10, t_air(1,'aa'));
SELECT * FROM v1 WHERE id = stu.type1.id;
SELECT * FROM t1 WHERE id = stu.type1.id;
END;
$$
CALL p1();
id	input	fmt
1	1234567	NULL
id	input	fmt
1	1234567	NULL
CALL p1();
id	input	fmt
1	1234567	NULL
id	input	fmt
1	1234567	NULL
drop PROCEDURE p1;

create table test as select 1;
create or replace view tv as 
select * from (
select '中文' as a from test
union all
select 'engl' as a from test
);
Warnings:
Warning	1300	Invalid utf8mb4 character string: 'D6D0CE'
Warning	1300	Cannot convert string '\xD6\xD0\xCE\xC4' from utf8mb4 to utf8mb3
create or replace view tvx as 
select * from (
select '' as a from test
union all
select 'engl' as a from test
);
# invalid charactor string would be cast to empty string, follow 4 sql return same result
select * from tv  order by 1;
a

engl

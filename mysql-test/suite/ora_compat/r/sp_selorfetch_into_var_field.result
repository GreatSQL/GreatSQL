SELECT v_emp_record.empno, v_emp_record.ename, v_emp_record.job, v_emp_record.salary;
END;
$$
call dynamic_record_demo$$
v_emp_record.empno	v_emp_record.ename	v_emp_record.job	v_emp_record.salary
7369	SMITH	CLERK	800
call dynamic_record_demo$$
v_emp_record.empno	v_emp_record.ename	v_emp_record.job	v_emp_record.salary
7369	SMITH	CLERK	800
DROP PROCEDURE dynamic_record_demo$$

[### test fetch static cursor into record variable in sp]
CREATE OR REPLACE PROCEDURE static_cursor_demo AS
TYPE emp_record_type IS RECORD (
empno    NUMBER(6),
ename    VARCHAR2(50),
job      VARCHAR2(50),
salary   NUMBER(8,2)
);
v_emp emp_record_type;
CURSOR emp_cur IS SELECT * FROM emp WHERE empno = 7369;
BEGIN
OPEN emp_cur;
LOOP
FETCH emp_cur INTO v_emp;
EXIT WHEN emp_cur%NOTFOUND;
SELECT v_emp.empno, v_emp.ename, v_emp.job, v_emp.salary;
END LOOP;
CLOSE emp_cur;
END static_cursor_demo;
$$
call static_cursor_demo$$
v_emp.empno	v_emp.ename	v_emp.job	v_emp.salary
7369	SMITH	CLERK	800
call static_cursor_demo$$
v_emp.empno	v_emp.ename	v_emp.job	v_emp.salary
7369	SMITH	CLERK	800
DROP PROCEDURE static_cursor_demo$$


[### test fetch ref cursor into record variable in sp]
CREATE OR REPLACE PROCEDURE strong_dynamic_cursor_demo AS
TYPE emp_record_type IS RECORD (
empno    NUMBER(6),
ename    VARCHAR2(50),
job      VARCHAR2(50),
salary   NUMBER(8,2)
);
TYPE emp_cur_type IS REF CURSOR RETURN emp%ROWTYPE;
v_emp_cursor emp_cur_type;
v_emp_record emp_record_type;
BEGIN
OPEN v_emp_cursor FOR  SELECT * FROM emp;
LOOP
FETCH v_emp_cursor INTO v_emp_record;
EXIT WHEN v_emp_cursor%NOTFOUND;
SELECT v_emp_record.empno, v_emp_record.ename, v_emp_record.job;
END LOOP;
CLOSE v_emp_cursor;
END strong_dynamic_cursor_demo;
$$
call strong_dynamic_cursor_demo$$
v_emp_record.empno	v_emp_record.ename	v_emp_record.job
7369	SMITH	CLERK
v_emp_record.empno	v_emp_record.ename	v_emp_record.job
7370	Judy	MANAGER
v_emp_record.empno	v_emp_record.ename	v_emp_record.job
7371	Will	CEO
call strong_dynamic_cursor_demo$$
v_emp_record.empno	v_emp_record.ename	v_emp_record.job
7369	SMITH	CLERK
v_emp_record.empno	v_emp_record.ename	v_emp_record.job
7370	Judy	MANAGER
v_emp_record.empno	v_emp_record.ename	v_emp_record.job
7371	Will	CEO
DROP PROCEDURE strong_dynamic_cursor_demo$$


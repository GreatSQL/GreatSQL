[### test fetch cursor into field of nested record variable in sp]
CREATE OR REPLACE PROCEDURE fetch_into_field_of_nested_record_var AS
TYPE emp_record_type IS RECORD (
empno    NUMBER(6),
ename    VARCHAR2(50),
job      VARCHAR2(50),
salary   NUMBER(8,2)
);
TYPE record_type IS RECORD (
record_id NUMBER(6),
v_emp     emp_record_type
);
v_record record_type;
CURSOR emp_cur IS SELECT empno FROM emp;
BEGIN
v_record.record_id := 1001;
OPEN emp_cur;
LOOP
FETCH emp_cur INTO v_record.v_emp.empno;
EXIT WHEN emp_cur%NOTFOUND;
SELECT v_record;
END LOOP;
CLOSE emp_cur;
END fetch_into_field_of_nested_record_var;
$$
call fetch_into_field_of_nested_record_var$$

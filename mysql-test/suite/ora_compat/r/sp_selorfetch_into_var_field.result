set sql_mode=oracle;
set @@udt_format_result='DBA';
CREATE TABLE emp (empno NUMBER, ename VARCHAR2(100), job VARCHAR2(100), sal NUMBER);
INSERT INTO emp VALUES (7369, 'SMITH', 'CLERK', 800);
INSERT INTO emp VALUES (7370, 'Judy', 'MANAGER', 8000);
INSERT INTO emp VALUES (7371, 'Will', 'CEO', 80000);
COMMIT;

[### test execute immediate into record variable in sp]
CREATE OR REPLACE PROCEDURE dynamic_record_demo AS
TYPE emp_record_type IS RECORD (
empno    NUMBER(6),
ename    VARCHAR2(50),
job      VARCHAR2(50),
salary   NUMBER(8,2)
);
v_emp_record emp_record_type;
v_sql        VARCHAR2(500);
v_emp_id     NUMBER := 7369;
BEGIN  
EXECUTE IMMEDIATE 'SELECT * FROM emp WHERE empno = ?;' INTO v_emp_record USING v_emp_id;
SELECT v_emp_record.empno, v_emp_record.ename, v_emp_record.job, v_emp_record.salary;
END;
$$
call dynamic_record_demo$$
v_emp_record.empno	v_emp_record.ename	v_emp_record.job	v_emp_record.salary
7369	SMITH	CLERK	800
call dynamic_record_demo$$
v_emp_record.empno	v_emp_record.ename	v_emp_record.job	v_emp_record.salary
7369	SMITH	CLERK	800
DROP PROCEDURE dynamic_record_demo$$

[### test execute immediate into field of record variable in sp]

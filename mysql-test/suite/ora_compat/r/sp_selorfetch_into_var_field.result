CREATE OR REPLACE PROCEDURE p1() AS
TYPE tklist IS TABLE OF t1%ROWTYPE INDEX BY PLS_INTEGER;
stu_record_val tklist;
stu_record2 t1%ROWTYPE;
TYPE stu_record1 IS RECORD(
id INT := 1,
name_d tklist
);
TYPE stu_record IS RECORD(
id INT := -1,
name_d  stu_record1,
score FLOAT := 0
);
stu stu_record;
CURSOR cc IS SELECT * FROM t1;
BEGIN
SELECT * INTO stu_record2 FROM t1 LIMIT 1;
SELECT stu;
OPEN cc;
FETCH cc INTO stu.name_d.name_d;
SELECT stu;
FETCH cc INTO stu.name_d.name_d.id, stu.name_d.name_d.name1;
SELECT stu;
END;
$$

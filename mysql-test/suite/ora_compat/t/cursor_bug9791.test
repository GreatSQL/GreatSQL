SET sql_mode=ORACLE;

show variables like '%udt_format_result%';
set @@udt_format_result='DBA';

CREATE SEQUENCE id_seq START WITH 1 INCREMENT BY 2 CACHE 1;
select id_seq.NEXTVAL;

--echo #
--echo # test of bug9791 with cursor
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1
IS
cursor cc is select id_seq.NEXTVAL from dual;
BEGIN
  for i in cc loop
    select i;
  end loop;
end;
$$
DELIMITER ;$$
call p1();
call p1();
drop SEQUENCE id_seq;
--error ER_UNKNOWN_TABLE
call p1();
CREATE SEQUENCE id_seq START WITH 1 INCREMENT BY 2 CACHE 1;
call p1();
drop PROCEDURE p1;

--echo #
--echo # test of bug9791 with refcursor cursor
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1
IS
c1 sys_refcursor;
count int;
BEGIN
  open c1 for select id_seq.NEXTVAL from dual;
  fetch c1 into count;
  select count;
end;
$$
DELIMITER ;$$
call p1();
call p1();
drop SEQUENCE id_seq;
--error ER_UNKNOWN_TABLE
call p1();
CREATE SEQUENCE id_seq START WITH 1 INCREMENT BY 2 CACHE 1;
call p1();
drop PROCEDURE p1;

--echo #
--echo # test of bug9791 with refcursor cursor
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1
IS
c1 sys_refcursor;
str varchar(100) := 'select id_seq.NEXTVAL from dual';
count int;
BEGIN
  open c1 for str;
  fetch c1 into count;
  select count;
end;
$$
DELIMITER ;$$
call p1();
call p1();
drop SEQUENCE id_seq;
--error ER_UNKNOWN_TABLE
call p1();
CREATE SEQUENCE id_seq START WITH 1 INCREMENT BY 2 CACHE 1;
call p1();
drop PROCEDURE p1;

--echo #
--echo # test of bug9791 with refcursor cursor
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1
IS
count int;
BEGIN
  for i in (select id_seq.NEXTVAL from dual) loop
    select i;
  end loop;
end;
$$
DELIMITER ;$$
call p1();
call p1();
drop SEQUENCE id_seq;
--error ER_UNKNOWN_TABLE
call p1();
CREATE SEQUENCE id_seq START WITH 1 INCREMENT BY 2 CACHE 1;
call p1();
drop PROCEDURE p1;

--echo #
--echo # test of bug9791 with default mode
--echo #
SET sql_mode=default;
DELIMITER $$;
CREATE PROCEDURE p1()
begin
  DECLARE q int;
  DECLARE qcur CURSOR FOR SELECT id_seq.NEXTVAL;
  OPEN qcur;
  FETCH qcur INTO q;
  select q;
end;
$$
DELIMITER ;$$
call p1();
call p1();
drop SEQUENCE id_seq;
--error ER_UNKNOWN_TABLE
call p1();
CREATE SEQUENCE id_seq START WITH 1 INCREMENT BY 2 CACHE 1;
call p1();
call p1();
drop PROCEDURE p1;

drop SEQUENCE id_seq;

--echo #
--echo # test of bug12478 with minus
--echo #
CREATE TABLE t1 (a INT, b VARCHAR(3));
insert into t1 values(1,'aa'),(2,'bb'),(3,'cc'),(6,'ee') ;
CREATE TABLE t2 (a INT, b VARCHAR(3));
insert into t2 values(1,'aa'),(4,'bb'),(3,'cc'),(5,'dd') ;
SET sql_mode=oracle;
DELIMITER $$;
CREATE or replace PROCEDURE p1()
IS
BEGIN
FOR v IN(
select * from t1
minus
select * from t2
) LOOP
SELECT v.a ;
END LOOP;
COMMIT;
exception
WHEN OTHERS THEN
ROLLBACK;
RETURN;
END;
$$
DELIMITER ;$$
call p1();
call p1();
drop PROCEDURE p1;

DELIMITER $$;
CREATE or replace PROCEDURE p1()
IS
BEGIN
FOR v IN(
select * from t1
except
select * from t2
) LOOP
SELECT v.a ;
END LOOP;
COMMIT;
exception
WHEN OTHERS THEN
ROLLBACK;
RETURN;
END;
$$
DELIMITER ;$$
call p1();
call p1();
drop PROCEDURE p1;

DELIMITER $$;
CREATE or replace PROCEDURE p1()
IS
BEGIN
FOR v IN(
select * from t1
intersect
select * from t2
) LOOP
SELECT v.a ;
END LOOP;
COMMIT;
exception
WHEN OTHERS THEN
ROLLBACK;
RETURN;
END;
$$
DELIMITER ;$$
call p1();
call p1();
drop PROCEDURE p1;

DELIMITER $$;
CREATE or replace PROCEDURE p1()
IS
BEGIN
FOR v IN(select * from (
select * from t1
intersect
select * from t2)
) LOOP
SELECT v.a ;
END LOOP;
COMMIT;
exception
WHEN OTHERS THEN
ROLLBACK;
RETURN;
END;
$$
DELIMITER ;$$
call p1();
call p1();
drop PROCEDURE p1;

drop table t1,t2;

set sql_mode = "NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,EMPTYSTRING_EQUAL_NULL,STRICT_ALL_TABLES";

CREATE TABLE t1 (c1 int, c2 int);
INSERT INTO t1 VALUES(1,2);

CREATE TABLE t2 SELECT "A" AS flag, c1, c2 FROM t1;

-- echo # test CREATE INDEX
CREATE INDEX idx_1 ON t2(c1);

-- echo # test CREATE TABLE ... LIKE
CREATE TABLE t3 LIKE t2;

-- echo # test ALTER TABLE
ALTER TABLE t2 add index idx_2(c2);
ALTER TABLE t2 add column c3 int not null default 0;
ALTER TABLE t2 drop column c2;
ALTER TABLE t2 modify column c1 bigint not null default 100;

DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t3;
--echo #
--echo # test of BUG11151
--echo #
CREATE TABLE TC10573_tb01 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    input VARCHAR2(100),
    fmt  VARCHAR2(100)
);

INSERT INTO TC10573_tb01 (id,input, fmt) VALUES (1,'1234567',null); 
INSERT INTO TC10573_tb01 (id,input, fmt) VALUES (2,'1,234.567','9,999.999'); 

DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1(num int) IS
   v_converted  NUMBER;
   TYPE t_rec IS TABLE OF TC10573_tb01%ROWTYPE INDEX BY INT;    
   rec1 t_rec;
   CURSOR c1 IS SELECT * FROM TC10573_tb01;
BEGIN
  FOR j in 1 .. num LOOP
    OPEN c1;
    fetch c1 bulk collect into rec1 ;
    for i in rec1.first .. rec1.last loop
      v_converted := to_number(rec1(i).input,rec1(i).fmt);
      select i,rec1(i).id,v_converted; 
    end loop;
    CLOSE c1;
  end loop;
END ;
$$
DELIMITER ;$$
call p1(2);
call p1(5);
drop PROCEDURE p1;

--echo #
--echo # test of BUG12857
--echo #
create table t1 like TC10573_tb01;
insert into t1 select * from TC10573_tb01;
create view v1 as select * from (select * from t1 union select * from TC10573_tb01) where id>0;

DELIMITER $$;
CREATE or replace procedure p1() as
begin
for i in (select * from t1) loop
  select * from v1 where v1.id=i.id;
end loop;
END ;
$$
DELIMITER ;$$
call p1();
call p1();
drop PROCEDURE p1;

--echo #
--echo # test of BUG13562
--echo #
set binlog_format='statement';
create or replace type t_air as object(id int,type varchar(20));

--echo #
--echo # test Item_splocal_row_field_by_name
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1() AS
    v_counter INT := 0;
BEGIN
    FOR cur_info IN (SELECT * FROM t1)
    LOOP
        SELECT * FROM v1 WHERE id = cur_info.id;
    END LOOP;
END;
$$
DELIMITER ;$$
CALL p1();
CALL p1();
drop PROCEDURE p1;

--echo #
--echo # test Item_splocal_row_field_table_by_name
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1() AS
  type t_test1 is record(
    id int := 1,
    type1 t_air);
  stu t_test1;
  type tklist is table of t_test1 index by binary_integer;
  stu_record_val tklist;
BEGIN
  stu := t_test1(10, t_air(1,'aa'));
  SELECT * FROM v1 WHERE id = stu.type1.id;
  SELECT * FROM t1 WHERE id = stu.type1.id;
END;
$$
DELIMITER ;$$
CALL p1();
CALL p1();
drop PROCEDURE p1;

--echo #
--echo # test Item_splocal_row_field_table_by_name
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1() AS
  type t_test1 is record(
    id int := 1,
    type1 t_air);
  type tklist is table of t_test1 index by binary_integer;
  stu_record_val tklist;
BEGIN
  stu_record_val := tklist(1=>t_test1(10, t_air(1,'aa')));
  SELECT * FROM v1 WHERE id = stu_record_val(1).type1.id;
  SELECT * FROM t1 WHERE id = stu_record_val(1).type1.id;
END;
$$
DELIMITER ;$$
CALL p1();
CALL p1();
drop PROCEDURE p1;

--echo #
--echo # test Item_splocal_row_field_table_by_index
--echo #
DELIMITER $$;
CREATE OR REPLACE PROCEDURE p1() AS
  type tklist is table of int index by binary_integer;
  stu_record_val tklist;
BEGIN
  stu_record_val := tklist(1=>1,2=>20);
  SELECT * FROM v1 WHERE id = stu_record_val(1);
  SELECT * FROM t1 WHERE id = stu_record_val(1);
END;
$$
DELIMITER ;$$
CALL p1();
CALL p1();
drop PROCEDURE p1;

drop view v1;
drop table t1;
drop table TC10573_tb01;
drop type t_air;



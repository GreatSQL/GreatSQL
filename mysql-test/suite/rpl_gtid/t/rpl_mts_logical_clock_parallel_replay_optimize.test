INSERT INTO t2 VALUES (4,4);
UPDATE t2 SET c2=c2+1 WHERE c1=3;
INSERT INTO t2 VALUES (5,5);
INSERT INTO t2 VALUES (6,6);
UPDATE t2 SET c2=c2+1 WHERE c1=3;
INSERT INTO t2 VALUES (7,7);
INSERT INTO t2 VALUES (8,8);
SELECT * FROM t1;
SELECT * FROM t2;
--source include/rpl/connection_replica.inc
--let $wait_condition=SELECT COUNT(*)=1 FROM INFORMATION_SCHEMA.processlist WHERE STATE LIKE '%Applying batch of row changes%'
--source include/wait_condition.inc
--let $wait_condition=SELECT COUNT(*)=3 FROM INFORMATION_SCHEMA.processlist WHERE STATE = 'Waiting for dependent transaction to commit'
--source include/wait_condition.inc
--let $wait_condition=SELECT COUNT(*)=8 FROM INFORMATION_SCHEMA.processlist WHERE STATE = 'Waiting for preceding transaction to commit'
--source include/wait_condition.inc
--let $assert_text = There only one transaction Applying rows
--let $assert_cond = "[SELECT COUNT(*) FROM INFORMATION_SCHEMA.processlist WHERE STATE LIKE \'%Applying batch of row changes%\']" = "1"
--source include/assert.inc
--let $assert_text = There have 3 thread waiting dependent transaction to commit 
--let $assert_cond = "[SELECT COUNT(*) FROM INFORMATION_SCHEMA.processlist WHERE STATE = \'Waiting for dependent transaction to commit\']" = "3"
--source include/assert.inc
--let $assert_text = There have 8 workers waiting preceding transaction to commit 
--let $assert_cond = "[SELECT COUNT(*) FROM INFORMATION_SCHEMA.processlist WHERE STATE = \'Waiting for preceding transaction to commit\']" = "8"
--source include/assert.inc
--let $assert_text = There have 4 workers idle
--let $assert_cond = "[SELECT COUNT(*) FROM INFORMATION_SCHEMA.processlist WHERE STATE = \'Waiting for an event from Coordinator\']" = "4"

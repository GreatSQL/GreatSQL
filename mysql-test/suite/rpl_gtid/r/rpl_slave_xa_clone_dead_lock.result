CHANGE REPLICATION SOURCE TO SOURCE_USER='root',SOURCE_HOST='127.0.0.1',SOURCE_PORT=PORT_1,SOURCE_AUTO_POSITION=1;
START REPLICA;
SET debug_sync='now WAIT_FOR reach_xa_guard';

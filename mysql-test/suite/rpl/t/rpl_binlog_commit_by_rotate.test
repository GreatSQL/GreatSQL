################################################################################
# Rename binlog cache to binlog file
#
# It verifies that the binlog caches which are larger
# than binlog_large_commit_threshold can be move to a binlog file
# successfully. With a successful rename,
#   - it rotates the binlog and the cache is renamed to the new binlog file
#   - an ignorable event is generated just before the Gtid_log_event of the
#     transaction to take the reserved spaces which is unused.
#
# It verifies that the renamed binlog file works well in replication.
#
# It also verifies that rename is not supported in below cases:
# though the cache is larger than the threshold
#   - binlog_large_commit_threshold is 0
#   - binlog encryption or compression is enabled
#   - transaction size less than the threshold
#   - binlog cache buffer is larger than threshold
#   - the offset used for calculating end_log_pos is not same to
#     the actual reserved space size
#
# Test steps:
#   0. Prepare.
#   1. Test binlog cache rename to binlog file with checksum off.
#   2. It works well in the situation that binlog header is larger than IO_SIZE.
#   3. RESET MASTER should work well.
#   4. Test binlog cache rename to binlog file with checksum on.
#   5. Not rename to binlog file if binlog_large_commit_threshold is 0.
#   6. Not rename to binlog file if binlog encryption or compression is enabled.
#   7. Not rename to binlog file if transaction size is less than the threshold.
#   8. Not rename to binlog file if binlog cache buffer is larger than threshold.
#   9. Not rename to binlog file if the offset used for calculating end_log_pos
#      is not same to the actual reserved space size.
################################################################################
--source include/have_binlog_format_row.inc
--source include/have_debug.inc
--source include/rpl/init_source_replica.inc

--echo # 0. Prepare.
--let $SERVER_UUID= query_get_value(SELECT @@SERVER_UUID, @@SERVER_UUID, 1)
SET @saved_binlog_large_commit_threshold= @@GLOBAL.binlog_large_commit_threshold;
SET @saved_binlog_checksum= @@GLOBAL.binlog_checksum;

SET GLOBAL binlog_checksum = "NONE";

CREATE TABLE t1 (c1 LONGTEXT) ENGINE = InnoDB;
CREATE TABLE t2 (c1 LONGTEXT) ENGINE = MyISAM;

INSERT INTO t1 values(repeat("1", 5242880));
INSERT INTO t1 values(repeat("1", 5242880));
INSERT INTO t2 values(repeat("1", 5242880));
INSERT INTO t2 values(repeat("1", 5242880));

FLUSH BINARY LOGS;

--echo #
--echo # 1. Test binlog cache rename to binlog file with checksum off.
--echo #
--source include/rpl/sync_to_replica.inc
--source include/rpl/stop_replica.inc

SET @saved_binlog_large_commit_threshold = @@GLOBAL.binlog_large_commit_threshold;
SET @saved_replica_parallel_workers = @@GLOBAL.replica_parallel_workers;

SET GLOBAL binlog_large_commit_threshold = 10 * 1024 * 1024;
SET GLOBAL replica_parallel_workers = 4;
--source include/rpl/start_replica.inc
# Block all DML on slave
BEGIN;
DELETE FROM t1;

--connection master
SET GLOBAL binlog_large_commit_threshold = 10 * 1024 * 1024;

--echo # Transaction cache can be renamed and works well with ROLLBACK TO SAVEPOINT
BEGIN;
SAVEPOINT s1;
UPDATE t1 SET c1 = repeat('2', 5242880);
ROLLBACK TO s1;
UPDATE t1 SET c1 = repeat('3', 5242880);
SAVEPOINT s2;
UPDATE t1 SET c1 = repeat('4', 5242880);
UPDATE t1 SET c1 = repeat('5', 5242880);
UPDATE t1 SET c1 = repeat('6', 5242880);
ROLLBACK TO SAVEPOINT s2;
COMMIT;
INSERT INTO t1 VALUES("after_update_t1");

--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000004' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--echo # statement cache can be renamed
--connection master
BEGIN;
UPDATE t2 SET c1 = repeat('4', 5242880);
INSERT INTO t1 VALUES("after_update_t2");
COMMIT;
--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000005' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--connection slave
# UPDATE t2 should be waiting for prior transactions to commit.
let $wait_condition=
      SELECT count(*) = 1 FROM information_schema.processlist
      WHERE State = "Waiting for dependent transaction to commit";
--source include/wait_condition.inc
ROLLBACK;

--connection master
--source include/rpl/sync_to_replica.inc

--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'slave-bin.000002' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'slave-bin.000003' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--let $binlog_file= slave-bin.000002
--let $binlog_start= 4
--let $keep_gtid_events= 1
--source include/rpl/deprecated/show_binlog_events.inc

--let $binlog_file= slave-bin.000003
--let $binlog_start= 4
--let $keep_gtid_events= 1
--source include/rpl/deprecated/show_binlog_events.inc

--source include/rpl/stop_replica.inc
SET GLOBAL binlog_large_commit_threshold = @saved_binlog_large_commit_threshold;
SET GLOBAL replica_parallel_workers = @saved_replica_parallel_workers;
--source include/rpl/start_replica.inc

--echo # CREATE SELECT works well
--connection master
CREATE TABLE t3 SELECT * FROM t1;
--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000006' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

CREATE TABLE t4 SELECT * FROM t2;
--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000007' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--echo # XA statement works well
XA START "test-a-long-xid========================================";
UPDATE t1 SET c1 = repeat('1', 5242880);
XA END "test-a-long-xid========================================";
XA PREPARE "test-a-long-xid========================================";
XA COMMIT "test-a-long-xid========================================";
--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000008' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

XA START "test-xid";
UPDATE t1 SET c1 = repeat('2', 5242880);
XA END "test-xid";
XA COMMIT "test-xid" ONE PHASE;
--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000009' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--echo #
--echo #  2. It works well in the situation that binlog header is larger than IO_SIZE.
--echo #
--disable_query_log

# make Previous_gtids_log_event larger than 64K
--let $server_id= 100000
while ($server_id < 102000)
{
  eval SET GTID_NEXT = '00000000-0000-0000-0000-000000$server_id:11111111';
  BEGIN;
  COMMIT;
  --inc $server_id
}
SET GTID_NEXT = 'AUTOMATIC';

--enable_query_log

# After flush, reserved space should be updated.
FLUSH BINARY LOGS;

UPDATE t1 SET c1 = repeat('3', 5242880);

--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000011' LIMIT 4, End_log_pos, 4)
# 81920 is 80K which is larger than 64K
--let $assert_cond= $gtid_end_pos = 81920
--let $assert_text= Rename is executed.
--source include/assert.inc

--echo #
--echo # 3. RESET MASTER should work well. It also verifies binlog checksum mechanism.
--echo #
--source include/rpl/reset.inc

--echo #
--echo # 4. Test binlog cache rename to binlog file with checksum on.
--echo #
SET GLOBAL binlog_checksum = "CRC32";

UPDATE t1 SET c1 = repeat('4', 5242880);
--let $gtid_end_pos= query_get_value(SHOW BINLOG EVENTS IN 'master-bin.000003' LIMIT 4, End_log_pos, 4)
--let $assert_cond= $gtid_end_pos = 4096
--let $assert_text= Rename is executed.
--source include/assert.inc

--echo #
--echo # 5. Not rename to binlog file if binlog_large_commit_threshold is 0.
--echo #
SET GLOBAL binlog_large_commit_threshold = 0;

UPDATE t1 SET c1 = repeat('5', 5242880);
--let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_cond= "$binlog_file" = "master-bin.000003"
--let $assert_text= Binlog is not rotated
--source include/assert.inc

SET GLOBAL binlog_large_commit_threshold = 10 * 1024 * 1024;

--echo #
--echo # 6. Not rename to binlog file if binlog encryption or compression is enabled.
--echo #
SET SESSION binlog_transaction_compression = ON;

UPDATE t1 SET c1 = repeat('7', 5242880);
--let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_cond= "$binlog_file" = "master-bin.000003"
--let $assert_text= Binlog is not rotated
--source include/assert.inc

SET SESSION binlog_transaction_compression = OFF;

--echo #
--echo # 7. Not renamed to binlog, since the binlog cache is not larger than
--echo #    the threshold. And it should works well after ROLLBACK TO SAVEPOINT
--echo #
SET GLOBAL binlog_large_commit_threshold = 128 * 1024 * 1024;

BEGIN;
SAVEPOINT s1;
UPDATE t1 SET c1 = repeat('8', 5242880);
ROLLBACK TO SAVEPOINT s1;
UPDATE t1 SET c1 = repeat('9', 5242880);
SAVEPOINT s2;
UPDATE t1 SET c1 = repeat('1', 5242880);
UPDATE t1 SET c1 = repeat('2', 5242880);
ROLLBACK TO SAVEPOINT s2;
COMMIT;

--let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_cond= "$binlog_file" = "master-bin.000003"
--let $assert_text= Binlog is not rotated
--source include/assert.inc

SET GLOBAL binlog_large_commit_threshold = 10 * 1024 * 1024;

--echo #
--echo # 8. Not rename to binlog file if binlog cache buffer is larger than threshold.
--echo #
SET @saved_binlog_cache_size= @@GLOBAL.binlog_cache_size;
SET GLOBAL binlog_cache_size = 64 * 1024 * 1024;
# Create new master connection to use new binlog_cache_size value
--connect (new_master, 127.0.0.1,root,,test,$MASTER_MYPORT,)

UPDATE t1 SET c1 = repeat('3', 5242880);
--let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_cond= "$binlog_file" = "master-bin.000003"
--let $assert_text= Binlog is not rotated
--source include/assert.inc

--connection master
SET GLOBAL binlog_cache_size = @saved_binlog_cache_size;

--echo #
--echo # 9. Not rename to binlog file if the offset used for calculating end_log_pos
--echo #    is not same to the actual reserved space size.
--echo #
SET debug = '+d,simulate_reserved_8KB';
BEGIN;
UPDATE t1 SET c1 = repeat('4', 5242880);
COMMIT;
SET debug = '-d,simulate_reserved_8KB';
--let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_cond= "$binlog_file" = "master-bin.000003"
--let $assert_text= Binlog is not rotated
--source include/assert.inc

# cleanup
DROP TABLE t1, t2, t3, t4;
SET GLOBAL binlog_large_commit_threshold = @saved_binlog_large_commit_threshold;
SET GLOBAL binlog_checksum = @saved_binlog_checksum;
--let $binlog_file=
--let $skip_checkpoint_events=0
--source include/rpl/deinit.inc

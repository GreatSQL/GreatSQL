--source include/have_binlog_format_row.inc
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
#
# add extra LAST_ERROR_MESSAGE info when replication error
#

connect (conn1,127.0.0.1,root,,test,$MASTER_MYPORT,);
connect (conn2,127.0.0.1,root,,test,$SLAVE_MYPORT,);

call mtr.add_suppression("Recovery from source pos .*");
call mtr.add_suppression("Corrupted table mysql.slave_worker_info");
call mtr.add_suppression("Could not delete from Replica Workers info repository");
call mtr.add_suppression("The replica coordinator and worker threads are stopped, possibly leaving data in inconsistent state");
call mtr.add_suppression("Replica SQL for channel '': .*Could not execute .* event on table");
call mtr.add_suppression("Replica SQL for channel '': Worker 1 failed executing transaction 'ANONYMOUS' at source log .*, end_log_pos [0-9]+; Related event data has been written to file: replica_report.error, Error_code: MY-001032");

# test items: 
#      when slave apply occur:
#      1.table with unique\primary key: If event is update\delete, write key to LAST_ERROR_MESSAGE.(like INSERT dup key conflict)
#      2.table no unique key:(default is 'hash scan')
#           (1)Log extra info(data that cannot apply) to report_file.
#           (2)Log report_file name in LAST_ERROR_MESSAGE.
#           (3)table may exists normal INDEX key.
#           (4)Try to create table with different type column to test.

SET session default_storage_engine=InnoDB;
# test: not exists key
--echo [test1: conflict without table key and NULL value]
# with big row
--connection conn1
--echo [connect conn1]
--disable_warnings
drop table if exists t1;
--enable_warnings
create table t1(c1 int, c2 longtext);
insert into t1 values(1,'A'),(2,'B'), (3,3), (4,4);
--source include/rpl/sync_to_replica.inc
--connection conn2
--echo [connect conn2]
set global replication_error_write_file=1000;
delete from t1 where c1 > 1;

--connection conn1
--echo [connect conn1]
delete from t1 where c1 > 0;

--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file, recorded filename in LAST_ERROR_MESSAGE.
--exec grep "Event table:" $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error

# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;

--connection conn1
--echo [connect conn1]
drop table t1;

# test NULL
create table t1(c1 int, c2 varchar(100), c3 int);
insert into t1 values(1,'A', 1),(2,'B', 2) , (3,3,3), (4,4,4), (NULL, 5, 5), (NULL, 6, 6);
--source include/rpl/sync_to_replica.inc
--connection conn2
--echo [connect conn2]
delete from t1 where c3=3 or c3=5 or c3 = 6;
--connection conn1
--echo [connect conn1]
delete from t1 where c3 > 1;
--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file.
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
drop table t1;



# test: exists key
--echo [test2: conflict with primary key]
create table t1(c1 int primary key, c2 longtext);
insert into t1 values(1,REPEAT('ManyMegaByteBlck', 2)),(2,REPEAT('ManyMegaByteBlck', 2)) , (3,3), (4,4);
--source include/rpl/sync_to_replica.inc
--connection conn2
--echo [connect conn2]
delete from t1 where c1 > 1;

--connection conn1
--echo [connect conn1]
delete from t1 where c1 > 0;

--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# not exists slave_report.error file, recorded primary key in LAST_ERROR_MESSAGE
--error 1
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
select regexp_substr(LAST_ERROR_MESSAGE, 'contains entry.*PRIMARY') from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
drop table t1;

--echo [test3: conflict with unique key]
create table t1(c1 int unique, c2 varchar(100), c3 int);
insert into t1 values(1,REPEAT('ManyMegaByteBlck', 2), 1),(2,REPEAT('ManyMegaByteBlck', 2), 2) , (3,3,3), (4,4,4), (5, 5, 5), (6, 6, 6);
--source include/rpl/sync_to_replica.inc
--connection conn2
--echo [connect conn2]
delete from t1 where c3 > 1;
--connection conn1
--echo [connect conn1]
delete from t1 where c3 > 0;
--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file, unique key may be set NULL. That is not unique.
# Report to file according to the m_key of m_distinct_keys_original_order.
--exec grep "Event table:" $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
drop table t1;

--echo [test4: conflict with index key]
create table t3(c1 int, c2 varchar(50), c3 int, c4 int);
create index idx_1 on t3 (c4);
create index idx_2 on t3 (c3);
insert into t3 values(1,'A',11,12),(2,'B',21,22),(3,'C',31,32),(4,'D',41,42);
--source include/rpl/sync_to_replica.inc
--connection conn2
--echo [connect conn2]
delete from t3 where c3=31;
--connection conn1
--echo [connect conn1]
delete from t3 where c1 =2 or (c1=3 and c3=31);
--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file, recorded filename in LAST_ERROR_MESSAGE
--let $wait_condition= select count(regexp_substr(LAST_ERROR_MESSAGE, 'contains entry.*PRIMARY'))=0 from performance_schema.replication_applier_status_by_worker;
--source include/wait_condition.inc
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
drop table t3;

--echo [test5: test mixed key]
# mix key: primary key and unique key and index key.
create table t3(c1 int, c2 varchar(50), c3 int, c4 int, primary key(c1,c3), INDEX idx(c2), unique key(c4));
insert into t3 values(1,'A',11,12),(2,'B',21,22),(3,'C',31,32),(4,'D',41,42);
--source include/rpl/sync_to_replica.inc
--connection conn2
--echo [connect conn2]
delete from t3 where c3=31;
--connection conn1
--echo [connect conn1]
delete from t3 where c1 =2 or (c1=3 and c3=31);
--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# not exists slave_report.error file, recorded primary key in LAST_ERROR_MESSAGE
--error 1
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
select regexp_substr(LAST_ERROR_MESSAGE, 'contains entry.*PRIMARY') from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
drop table t3;

--echo [test6: test with multiple data type column]
--echo [prepare data included all data types data: create table t1]
--source include/all_data_types_data.inc
alter table t1 modify column col_tinyint tinyint;
alter table t1 drop primary key;
--source include/rpl/sync_to_replica.inc

--connection conn2
--echo [connect conn2]
delete from t1 where col_tinyintus > 0;

--connection conn1
--echo [connect conn1]
delete from t1 where col_tinyintus >= 0;


--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file, recorded filename in LAST_ERROR_MESSAGE.
--exec grep "Event table:" $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error

# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;

--connection conn1
--echo [connect conn1]
drop table t1;
drop table t2;

--echo [test7: test with invisible column and beyond the replication_error_write_file]
create table t3(c1 int, c2 varchar(50), c3 int, c4 int);
insert into t3 values(1,'A',11,12),(2,'B',21,22),(3,'C',31,32),(4,'D',41,42),(5,'E',51,52),(6,'F',61,62);
alter table t3 modify column c4 int invisible;
--source include/rpl/sync_to_replica.inc

--connection conn2
--echo [connect conn2]
set global replication_error_write_file=2;
delete from t3 where c3 > 2;
--connection conn1
--echo [connect conn1]
delete from t3 where c1 > 1;
--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file, recorded filename in LAST_ERROR_MESSAGE
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
drop table t3;

--echo [test8: test with update and delete]
create table t1(c1 int, c2 longtext);
insert into t1 values(1,REPEAT('ManyMegaByteBlck', 2)),(2,REPEAT('ManyMegaByteBlck', 2)), (3,3), (4,4);
--source include/rpl/sync_to_replica.inc

--connection conn2
--echo [connect conn2]
set global replication_error_write_file=1000;
update t1 set c2="myupdate text" where c1 > 1;
delete from t1 where c1=3;
update t1 set c2="update c4, myupdate text" where c1=4;

--connection conn1
--echo [connect conn1]
delete from t1 where c1 = 4;
delete from t1 where c1 > 1;

--connection conn2
--echo [connect conn2]
--let $wait_condition= select count(LAST_ERROR_MESSAGE)=1 from performance_schema.replication_applier_status_by_worker where LAST_ERROR_MESSAGE!='';
--source include/wait_condition.inc
# must exists slave_report.error file, recorded filename in LAST_ERROR_MESSAGE.
--exec grep "Event table:" $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec sed -i '1,6d' $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec cat $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error
--exec rm $MYSQLTEST_VARDIR/mysqld.2/data/replica_report.error

# clean env
stop replica;
set global sql_replica_skip_counter = 1;
start replica;
--connection conn1
--echo [connect conn1]
truncate table t1;
--connection conn2
--echo [connect conn2]
stop replica;
set global sql_replica_skip_counter = 1;
start replica;

--connection conn1
--echo [connect conn1]
drop table t1;
--source include/rpl/sync_to_replica.inc

# clean
--connection conn2
--echo [connect conn2]
set global replication_error_write_file=500;
--source include/rpl/connection_replica.inc
STOP REPLICA;
RESET REPLICA ALL;
--let $rpl_skip_stop_slave=1
--let $rpl_skip_sync = 1
--source include/rpl/deinit.inc

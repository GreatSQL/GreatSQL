#############################################################################
# Test the scenario of collisions occurs between the AI and another row's BI
# ​within a single Update_rows_log_event.
# Ex:
#   UPDATE  A1 -> A2
#   UPDATE  B1 -> B2
# A2 and B1 have the same hash value after the make_hash_key() function call.
#############################################################################

--source include/rpl/init_source_replica.inc

--echo
--echo # case 1
--echo

--connection master

CREATE TABLE test_table1 (
    c1 int NOT NULL,
    c2 int NOT NULL,
    c3 varchar(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c4 decimal(20,0) NOT NULL,
    c5 varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin NOT NULL,
    c6 decimal(20,0) NOT NULL,
    c7 varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c8 decimal(10,0) DEFAULT NULL,
    c9 decimal(16,0) DEFAULT NULL,
    c10 decimal(24,4) DEFAULT NULL,
    c11 decimal(20,0) DEFAULT NULL,
    c12 varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c13 decimal(20,0) DEFAULT NULL,
    c14 varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c15 decimal(20,0) DEFAULT NULL,
    c16 varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c17 varchar(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c18 decimal(14,0) DEFAULT NULL,
    c19 varchar(2000) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c20 varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c21 varchar(1024) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c22 varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c23 varchar(164) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c24 decimal(16,0) DEFAULT NULL,
    c25 datetime DEFAULT NULL,
    c26 bigint NOT NULL,
    c27 varchar(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_bin;

alter table test_table1 add key(c26);

INSERT INTO test_table1 VALUES (202506, 20250628, '2025062815166459365000', 10052834744, '9200060014', 26086862007, '', 3600, 10, 22.0000, 10040, NULL, NULL, NULL, NULL, NULL, '32', 3100090401, ';10052834744;9200060;9200060014;26086862007;3100090401;900003001;1;0;9000030011;20250628;130000;3600;880000;1;880000;;10052834744;0;0;', '1', NULL, 'gfWB', '6aa7c62e-b66b-4290-81fe-92f67e69bb75', 0, '2025-06-29 05:03:48', 29381138, '');
INSERT INTO test_table1 VALUES (202506, 20250628, '2025062805100000000795959454', 10011909444, '111716417', 26066446148, '', 3600, 0, 19.0000, 10040, NULL, NULL, NULL, NULL, NULL, '32', 3800009531, ';10011909444;111716;111716417;26066446148;3800009531;900003001;1;0;9000030011;20250628;40000;3600;2;1;2;;10011909444;0;0;', '1', NULL, 'GFFB', '884f6587-efd6-4aae-9420-32667f0d315c', 0, '2025-06-29 05:03:48', 10783083, '');

update test_table1 set c12 = FORMAT(c10 / 1000, 3);

select * from test_table1;
--let $lhs = `checksum table test_table1`

--source include/rpl/sync_to_replica.inc

--connection slave

select * from test_table1;
--let $rhs = `checksum table test_table1`

--let $assert_text = data consistency
--let $assert_cond = "$lhs" = "$rhs"
--source include/assert.inc

--connection master
drop table test_table1;

--echo
--echo # case 2
--echo

--connection master

CREATE TABLE test_table2 (
    c1 decimal(20,0) DEFAULT NULL,
    c2 decimal(16,0) DEFAULT NULL,
    c3 varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c4 int DEFAULT NULL,
    c5 decimal(6,0) DEFAULT NULL,
    c6 decimal(12,0) DEFAULT NULL,
    c7 decimal(12,0) DEFAULT NULL,
    c8 decimal(12,0) DEFAULT NULL,
    c9 decimal(12,0) DEFAULT NULL,
    c10 varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
    c11 decimal(6,0) DEFAULT NULL,
    c12 decimal(6,0) DEFAULT NULL,
    c13 decimal(16,0) DEFAULT NULL,
    c14 decimal(16,0) DEFAULT NULL,
    c15 decimal(16,0) DEFAULT NULL,
    c16 decimal(16,0) DEFAULT NULL,
    c17 decimal(6,0) DEFAULT NULL,
    c18 datetime DEFAULT NULL,
    c19 decimal(8,0) DEFAULT NULL,
    c20 decimal(18,0) DEFAULT NULL,
    c21 decimal(6,0) DEFAULT NULL,
    c22 decimal(16,0) DEFAULT NULL,
    c23 decimal(6,0) DEFAULT NULL,
    c24 decimal(8,0) DEFAULT NULL,
    c25 decimal(16,0) DEFAULT NULL,
    c26 decimal(16,0) DEFAULT NULL,
    c27 decimal(16,0) DEFAULT NULL,
    c28 decimal(16,0) DEFAULT NULL,
    c29 decimal(8,0) DEFAULT NULL,
    UNIQUE KEY `UNX_PBILL_SUBTOTAL_ITEM11` (`c2`,`c7`,`c9`,`c6`,`c10`,`c4`),
    KEY `IDX_BILL_SUBTOTAL_ITEM_SID` (`c7`),
    KEY `UNX_PBILL_SUBTOTAL_ITEM_CA111` (`c2`,`c3`),
    KEY `UNX_PBILL_SUBTOTAL_ITEM_SEQ111` (`c1`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_bin;

load data infile '../../std_data/AI_BI_hash_collisions.dat' into table test_table2 fields terminated by ',' lines terminated by '\n';
UPDATE test_table2 SET c5 = 690.06, c17 = 689.31, c14 = 52.87 WHERE c2 BETWEEN 1 AND 5000;

select * from test_table2;
--let $lhs = `checksum table test_table2`

--source include/rpl/sync_to_replica.inc

--connection slave

select * from test_table2;
--let $rhs = `checksum table test_table2`

--let $assert_text = data consistency
--let $assert_cond = "$lhs" = "$rhs"
--source include/assert.inc

--connection master
drop table test_table2;

--source include/rpl/deinit.inc

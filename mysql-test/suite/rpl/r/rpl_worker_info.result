col_SET SET('C', 'G', 'O'),
col_CLOB CLOB,
col_number number,
col_VARCHAR2 VARCHAR2(100),
col_plsinteger PLS_INTEGER,
col_long long,
col_raw varchar2(200),
col_json json
);

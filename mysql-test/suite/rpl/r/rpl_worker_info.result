include/rpl/sync_to_replica.inc
[connect conn2]
set global replication_error_write_file=1000;
update t1 set c2="myupdate text" where c1 > 1;
delete from t1 where c1=3;
update t1 set c2="update c4, myupdate text" where c1=4;

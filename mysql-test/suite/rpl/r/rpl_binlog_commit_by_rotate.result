include/rpl/stop_replica.inc
SET GLOBAL binlog_large_commit_threshold = @saved_binlog_large_commit_threshold;
SET GLOBAL replica_parallel_workers = @saved_replica_parallel_workers;
include/rpl/start_replica.inc
# CREATE SELECT works well
CREATE TABLE t3 SELECT * FROM t1;
include/assert.inc [Rename is executed.]
CREATE TABLE t4 SELECT * FROM t2;
include/assert.inc [Rename is executed.]
# XA statement works well
XA START "test-a-long-xid========================================";
UPDATE t1 SET c1 = repeat('1', 5242880);
XA END "test-a-long-xid========================================";
XA PREPARE "test-a-long-xid========================================";
XA COMMIT "test-a-long-xid========================================";
include/assert.inc [Rename is executed.]
XA START "test-xid";
UPDATE t1 SET c1 = repeat('2', 5242880);
XA END "test-xid";
XA COMMIT "test-xid" ONE PHASE;
include/assert.inc [Rename is executed.]
#
#  2. It works well in the situation that binlog header is larger than IO_SIZE.
#
FLUSH BINARY LOGS;
UPDATE t1 SET c1 = repeat('3', 5242880);
include/assert.inc [Rename is executed.]
#
# 3. RESET MASTER should work well. It also verifies binlog checksum mechanism.
#
include/rpl/reset.inc
#
# 4. Test binlog cache rename to binlog file with checksum on.
#
SET GLOBAL binlog_checksum = "CRC32";
UPDATE t1 SET c1 = repeat('4', 5242880);
include/assert.inc [Rename is executed.]
#
# 5. Not rename to binlog file if binlog_large_commit_threshold is 0.
#
SET GLOBAL binlog_large_commit_threshold = 0;
UPDATE t1 SET c1 = repeat('5', 5242880);
include/assert.inc [Binlog is not rotated]
SET GLOBAL binlog_large_commit_threshold = 10 * 1024 * 1024;
#
# 6. Not rename to binlog file if binlog encryption or compression is enabled.
#
SET SESSION binlog_transaction_compression = ON;
UPDATE t1 SET c1 = repeat('7', 5242880);
include/assert.inc [Binlog is not rotated]
SET SESSION binlog_transaction_compression = OFF;
#
# 7. Not renamed to binlog, since the binlog cache is not larger than
#    the threshold. And it should works well after ROLLBACK TO SAVEPOINT
#
SET GLOBAL binlog_large_commit_threshold = 128 * 1024 * 1024;
BEGIN;
SAVEPOINT s1;
UPDATE t1 SET c1 = repeat('8', 5242880);
ROLLBACK TO SAVEPOINT s1;
UPDATE t1 SET c1 = repeat('9', 5242880);
SAVEPOINT s2;
UPDATE t1 SET c1 = repeat('1', 5242880);
UPDATE t1 SET c1 = repeat('2', 5242880);
ROLLBACK TO SAVEPOINT s2;
COMMIT;
include/assert.inc [Binlog is not rotated]
SET GLOBAL binlog_large_commit_threshold = 10 * 1024 * 1024;
#
# 8. Not rename to binlog file if binlog cache buffer is larger than threshold.
#
SET @saved_binlog_cache_size= @@GLOBAL.binlog_cache_size;
SET GLOBAL binlog_cache_size = 64 * 1024 * 1024;
UPDATE t1 SET c1 = repeat('3', 5242880);
include/assert.inc [Binlog is not rotated]
SET GLOBAL binlog_cache_size = @saved_binlog_cache_size;
#
# 9. Not rename to binlog file if the offset used for calculating end_log_pos
#    is not same to the actual reserved space size.
#
SET debug = '+d,simulate_reserved_8KB';
BEGIN;
UPDATE t1 SET c1 = repeat('4', 5242880);
COMMIT;
SET debug = '-d,simulate_reserved_8KB';
include/assert.inc [Binlog is not rotated]
DROP TABLE t1, t2, t3, t4;
SET GLOBAL binlog_large_commit_threshold = @saved_binlog_large_commit_threshold;
SET GLOBAL binlog_checksum = @saved_binlog_checksum;
include/rpl/deinit.inc

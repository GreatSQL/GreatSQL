################################################################################
#
# The auto-rejoin process is a mechanism that allows a server that left the
# group due to flaky network (either on his side or on the other members) to
# try to join again up to group_replication_autorejoin_tries number of times.
#
# This test shall verify that it is possible to immediately react to a gcs level
# failure in joining the group, rather than waiting for the view modification to
# timeout.
#
# Test:
# 0) The test requires three servers.
# 1) Provoke a member expel.
# 2) Monitoring the auto-rejoin process from start to stop.​
# 3) Verify that waiting for the view modification to timeout did not occur.
# 4) Restore server1.
# 5) Cleanup.
#
################################################################################
--source include/have_debug_sync.inc
--source include/big_test.inc
--source include/linux.inc
--source include/have_group_replication_plugin.inc
--let $rpl_server_count = 3
--source include/group_replication.inc

--echo
--echo ####
--echo # 0) The test requires three servers.
--echo ####
--echo
--let $rpl_connection_name = server1
--source include/connection.inc

--source include/gr_autorejoin_monitoring.inc

SET @orig_log_error_verbosity= @@GLOBAL.log_error_verbosity;
SET GLOBAL log_error_verbosity=3;

SET sql_log_bin = 0;
call mtr.add_suppression("Member was expelled from the group due to network failures, changing member status to ERROR.");
call mtr.add_suppression("The server was automatically set into read only mode after an error was detected.");
call mtr.add_suppression("Unable to confirm whether the server has left the group or not. Check performance_schema.replication_group_members to check group membership information.");
call mtr.add_suppression("Started auto-rejoin procedure attempt*");
call mtr.add_suppression("Auto-rejoin procedure attempt*");
call mtr.add_suppression("Unable to initialize the group communication engine");
call mtr.add_suppression("The server was automatically set into offline mode after an error was detected");
SET sql_log_bin = 1;

--echo
--echo ####
--echo # 1) Provoke a member expel.
--echo ####
--echo
# Save the local address so we can restore it later
--let $local_address_server = `SELECT @@GLOBAL.group_replication_local_address`

# First, enable auto-rejoin
SET GLOBAL group_replication_autorejoin_tries = 3;
SET GLOBAL group_replication_autorejoin_interval = 5;

# Mess up the local address so we mock a gcs level join failure
SET GLOBAL group_replication_local_address = "127.0.0.1:0";

# Force expel on member 1
--let $member_id = `SELECT @@GLOBAL.server_uuid`
--source include/gr_expel_member_from_group.inc

--echo
--echo ####
--echo # 2) Monitoring the auto-rejoin process from start to stop.​
--echo ####
--echo
# Wait until auto-rejoin starts
--let $wait_condition = SELECT IS_AUTOREJOIN_RUNNING() = TRUE
--source include/wait_condition_or_abort.inc

# Wait until auto-rejoin stops
--let $wait_condition = SELECT IS_AUTOREJOIN_RUNNING() = FALSE
--source include/wait_condition_or_abort.inc

--echo
--echo ####
--echo # 3) Verify that waiting for the view modification to timeout did not occur.
--echo ####
--echo
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= Wait for view modification, timeout:60
--let $assert_text= Verify 'Wait for view modification timeout' is absent in test1.sql.
--let $assert_count= 0
--source include/assert_grep.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= on_gcs_join_failed is called
--let $assert_text= Found the expected information line in the server error log.
--let $assert_count= 3
--source include/assert_grep.inc

--echo
--echo ####
--echo # 4) Restore server1.
--echo ####
--echo
--source include/stop_group_replication.inc

# Should be in OFFLINE state
--let $group_replication_member_state= OFFLINE
--let $group_replication_member_id= $member_id
--source include/gr_wait_for_member_state.inc

--replace_result $local_address_server LOCAL_ADDRESS_SERVER
--eval SET GLOBAL group_replication_local_address = "$local_address_server"
--source include/start_group_replication.inc

--echo
--echo ####
--echo # 5) Cleanup.
--echo ####
--echo
SET GLOBAL log_error_verbosity= @orig_log_error_verbosity;
SET GLOBAL group_replication_autorejoin_tries = default;
SET GLOBAL group_replication_autorejoin_interval = default;
--source include/gr_end_autorejoin_monitoring.inc
--source include/group_replication_end.inc

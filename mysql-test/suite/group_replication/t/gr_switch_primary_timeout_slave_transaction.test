#######################################################################################
# When executing the group_replication_set_as_primary() with a timeout parameter,
# a monitoring thread will be opened to prevent the execution of new transactions.
# But at this time, the current primary may be applying events, which may also be
# stopped by the monitoring thread, causing the slave worker to stop and the node
# to exit the group.
#
# Test :
# 0. The test requires two servers: M1 and M2.
# 1. Start group in single primary mode, M1(primary) and M2(secondary).
# 2. Switch primary to server2. Both server1 and server2
#    will pause after the read mode is set.
# 3. Wait for the THD_transaction_monitor thread to start.
# 4. Currently, server2's read_only is off. Insert a piece of data.
#    When applying this event, server1 should successfully pass through
#    Trans_delegate::trans_begin and Trans_delegate::before_commit.
# 5. Reap the results.
# 6. Switch primary back to server1.
# 7. Assert primary and secondary status are correct.
#    Assert data is present on both members.
# 8. Cleanup.
#######################################################################################
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_group_replication_plugin.inc
--let $rpl_skip_group_replication_start= 1
--let $rpl_group_replication_single_primary_mode=1
--source include/group_replication.inc

--echo
--echo # 1. Start group in single primary mode, M1(primary) and M2(secondary).

--let $server1_uuid= query_get_value(SELECT @@SERVER_UUID, @@SERVER_UUID, 1)
--source include/start_and_bootstrap_group_replication.inc

CREATE TABLE t1(c1 int primary key);

--let $rpl_connection_name= server2
--source include/connection.inc

--let $server2_uuid= query_get_value(SELECT @@SERVER_UUID, @@SERVER_UUID, 1)
--source include/start_group_replication.inc

connect (conn1_1,127.0.0.1,root,,test,$MASTER_MYPORT,);
connect (conn2_1,127.0.0.1,root,,test,$SERVER_MYPORT_2,);
connect (conn2_2,127.0.0.1,root,,test,$SERVER_MYPORT_2,);
connect (conn2_3,127.0.0.1,root,,test,$SERVER_MYPORT_2,);

--echo
--echo # 2. Switch primary to server2. Both server1 and server2
--echo #    will pause after the read mode is set.

--echo [connect conn1_1]
connection conn1_1;
SET @@GLOBAL.DEBUG= '+d,before_secondary_signal_read_mode_ready';
SET @@GLOBAL.DEBUG= '+d,wait_before_commit';

--echo [connect conn2_1]
connection conn2_1;
SET @@GLOBAL.DEBUG= '+d,before_primary_signal_read_mode_ready';

--echo [connect conn2_2]
connection conn2_2;
--replace_result $server2_uuid SERVER2_UUID
send_eval SELECT group_replication_set_as_primary("$server2_uuid", 3);

--echo [connect conn1_1]
connection conn1_1;
SET DEBUG_SYNC= "now wait_for signal.secondary_signal_read_mode_ready_reached";
SET @@GLOBAL.DEBUG= '-d,before_secondary_signal_read_mode_ready';

--echo [connect conn2_1]
connection conn2_1;
SET DEBUG_SYNC= "now wait_for signal.primary_signal_read_mode_ready_reached";
SET @@GLOBAL.DEBUG= '-d,before_primary_signal_read_mode_ready';

--echo
--echo # 3. Wait for the THD_transaction_monitor thread to start.

--let $rpl_connection_name= server1
--source include/connection.inc

--let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.threads WHERE NAME = "thread/group_rpl/THD_transaction_monitor"
--source include/wait_condition.inc

--echo
--echo # 4. Currently, server2's read_only is off. Insert a piece of data.
--echo #    When applying this event, server1 needs to successfully pass through
--echo #    Trans_delegate::trans_begin and Trans_delegate::before_commit.

--echo [connect conn2_3]
connection conn2_3;
SET @group_replication_consistency_save= @@SESSION.group_replication_consistency;
SET @@SESSION.group_replication_consistency= 'EVENTUAL';
INSERT INTO t1 VALUES(1);
SET @@SESSION.group_replication_consistency= @group_replication_consistency_save;

--echo [connect conn1_1]
connection conn1_1;
SET DEBUG_SYNC= "now wait_for reach_sync";
SET @@GLOBAL.DEBUG= '-d,wait_before_commit';

sleep 3;

SET DEBUG_SYNC= "now signal end_sync";

--echo
--echo # 5. Reap the results.

--echo [connect conn1_1]
connection conn1_1;
SET DEBUG_SYNC= "now signal signal.secondary_signal_read_mode_ready_continue";
SET DEBUG_SYNC= 'RESET';

--echo [connect conn2_1]
connection conn2_1;
SET DEBUG_SYNC= "now signal signal.primary_signal_read_mode_ready_continue";
SET DEBUG_SYNC= 'RESET';

--echo [connect conn2_2]
connection conn2_2;
--replace_result $server2_uuid SERVER2_UUID
reap;

--echo
--echo # 6. Switch primary back to server1.

--echo [connect conn2_2]
connection conn2_2;
--replace_result $server1_uuid SERVER1_UUID
eval SELECT group_replication_set_as_primary("$server1_uuid", 3);

--echo
--echo # 7. Assert primary and secondary status are correct.
--echo #    Assert data is present on both members.

--let $rpl_connection_name= server1
--source include/connection.inc

--source include/gr_assert_primary_member.inc

--let $rpl_connection_name= server2
--source include/connection.inc

--source include/gr_assert_secondary_member.inc

--let $assert_text= 'There is a value 1 in table t1'
--let $assert_cond= [SELECT COUNT(*) AS count FROM t1 WHERE t1.c1 = 1, count, 1] = 1
--source include/assert.inc

--let $diff_tables= server1:test.t1, server2:test.t1
--source include/diff_tables.inc

--echo
--echo # 8. Cleanup.

--let $rpl_connection_name= server1
--source include/connection.inc

DROP TABLE t1;

--source include/rpl/sync.inc
--source include/group_replication_end.inc

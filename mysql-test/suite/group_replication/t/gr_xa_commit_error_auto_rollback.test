--source include/have_debug.inc
--let $group_replication_group_name=aabbccdd-eeff-eeff-eeff-112233445566
--source include/have_group_replication_plugin.inc
--let $rpl_skip_group_replication_start= 1
--source include/group_replication.inc
--let $rpl_server_count= 3


--disable_query_log
--connection server1
SET SESSION sql_log_bin= 0;
call mtr.add_suppression("Plugin group_replication reported: 'Transaction cannot be executed while Group Replication is stopping.'");
call mtr.add_suppression("Plugin group_replication reported: 'Error while broadcasting the transaction to the group on session");
call mtr.add_suppression("Run function 'before_commit' in plugin 'group_replication' failed");
call mtr.add_suppression("Found 1 prepared XA transactions");
call mtr.add_suppression("Plugin group_replication reported: 'unable to commit transaction after server shutdown'");
SET SESSION sql_log_bin= 1;
--enable_query_log

--connection server1
--echo server1
--source include/start_and_bootstrap_group_replication.inc
--connection server2
--echo server2
--source include/start_group_replication.inc
--connection server3
--echo server3
--source include/start_group_replication.inc

--connection server1
--echo server1
CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT);
INSERT INTO t1 VALUES (1,1);

--echo ## test internal_xa_commit error with stop mgr
connect (conn1_1_1,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_1_2,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_1_3,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn2_1_1,127.0.0.1,root,,test,$SERVER_MYPORT_2,);
connection conn1_1_1;
--echo [connect conn1_1_1]
XA START '1';
UPDATE t1 SET c2=c2+1 WHERE c1=1;
XA END '1';
XA PREPARE '1';
SET DEBUG='+d,xa_commit_wait';
send XA COMMIT '1';
sleep 1;
connection conn1_1_2;
--echo [connect conn1_1_2]
SET DEBUG_SYNC='now WAIT_FOR reach_wait_sync';
send STOP GROUP_REPLICATION;
sleep 1;
connection conn1_1_3;
--echo [connect conn1_1_3]
SET DEBUG_SYNC='now SIGNAL end_wait_sync';
connection conn1_1_2;
--echo [connect conn1_1_2]
reap;
connection conn1_1_1;
--echo [connect conn1_1_1]
--error 3100
reap;
XA RECOVER;
## disconnect conn1_1_1 to release xid
## otherwise, when sync from server2, will lead repl error
disconnect conn1_1_1;
connection conn2_1_1;
--echo [connect conn2_1_1]
SET SESSION group_replication_consistency='BEFORE';
XA RECOVER;
SELECT * FROM t1;
XA COMMIT '1';
SELECT * FROM t1;
--connection server1
--echo server1
--source include/start_group_replication.inc
connection conn1_1_2;
--echo [connect conn1_1_2]
SET SESSION group_replication_consistency='BEFORE';
XA RECOVER;
SELECT * FROM t1;
UPDATE t1 SET c2=c1 WHERE c1=1;
disconnect conn1_1_2;
disconnect conn1_1_3;
disconnect conn2_1_1;

--echo ## test external_xa_commit error with stop mgr
connect (conn1_2_1,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_2_2,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_2_3,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_2_4,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn2_2_1,127.0.0.1,root,,test,$SERVER_MYPORT_2,);
connection conn1_2_1;
--echo [connect conn1_2_1]
XA START '1';
UPDATE t1 SET c2=c2+1 WHERE c1=1;
XA END '1';
XA PREPARE '1';
disconnect conn1_2_1;
connection conn1_2_2;
--echo [connect conn1_2_2]
SET DEBUG='+d,xa_commit_wait';
send XA COMMIT '1';
sleep 1;
connection conn1_2_3;
--echo [connect conn1_2_3]
SET DEBUG_SYNC='now WAIT_FOR reach_wait_sync';
send STOP GROUP_REPLICATION;
sleep 1;
connection conn1_2_4;
--echo [connect conn1_2_4]
SET DEBUG_SYNC='now SIGNAL end_wait_sync';
connection conn1_2_3;
--echo [connect conn1_2_3]
reap;
connection conn1_2_2;
--echo [connect conn1_2_2]
--error 3100
reap;
XA RECOVER;
connection conn2_2_1;
--echo [connect conn2_2_1]
SET SESSION group_replication_consistency='BEFORE';
XA RECOVER;
SELECT * FROM t1;
XA COMMIT '1';
SELECT * FROM t1;
--connection server1
--echo server1
--source include/start_group_replication.inc
connection conn1_2_2;
--echo [connect conn1_2_2]
SET SESSION group_replication_consistency='BEFORE';
XA RECOVER;
SELECT * FROM t1;
UPDATE t1 SET c2=c1 WHERE c1=1;
disconnect conn1_2_2;
disconnect conn1_2_3;
disconnect conn1_2_4;
disconnect conn2_2_1;

--echo ## test internal_xa_rollback error with stop mgr
connect (conn1_3_1,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_3_2,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn1_3_3,127.0.0.1,root,,test,$SERVER_MYPORT_1,);

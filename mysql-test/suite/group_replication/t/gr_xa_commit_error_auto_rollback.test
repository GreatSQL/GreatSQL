SELECT * FROM t1;
XA COMMIT '1';
SELECT * FROM t1;
--connection server1
--echo server1
--source include/start_group_replication.inc
connection conn1_3_2;
--echo [connect conn1_3_2]
SET SESSION group_replication_consistency='BEFORE';
XA RECOVER;
SELECT * FROM t1;
UPDATE t1 SET c2=c1 WHERE c1=1;
disconnect conn1_3_2;
disconnect conn1_3_3;
disconnect conn2_3_1;


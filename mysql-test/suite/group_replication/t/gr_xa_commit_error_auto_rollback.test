UPDATE t1 SET c2=c1 WHERE c1=1;
disconnect conn1_4_2;
disconnect conn1_4_3;
disconnect conn1_4_4;
disconnect conn2_4_1;



--echo ## test internal_xa_commit error with kill
--connection server1
--let $s1_local_address=`SELECT @@group_replication_local_address`
--let $s1_seeds=`SELECT @@group_replication_group_seeds`
connect (conn1_5_1,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connect (conn2_5_1,127.0.0.1,root,,test,$SERVER_MYPORT_2,);
connection conn1_5_1;
--echo [connect conn1_5_1]
XA START '1';
UPDATE t1 SET c2=c2+1 WHERE c1=1;
XA END '1';
XA PREPARE '1';
SET DEBUG='+d,xa_commit_sleep';
send XA COMMIT '1';
sleep 1;
--connection server1
--echo [server1 shutdown]
--let $_server_id= `SELECT @@server_id`
--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.$_server_id.expect
--let $mysqld_pid_file=`SELECT @@GLOBAL.pid_file`
--source include/expect_crash.inc
exec kill `cat $mysqld_pid_file`;
--source include/wait_until_disconnected.inc
connection conn1_5_1;
--echo [connect conn1_5_1]
--error 2013,3100
reap;
connection conn2_5_1;
--echo [connect conn2_5_1]
SET SESSION group_replication_consistency='BEFORE';
XA RECOVER;
SELECT * FROM t1;
XA COMMIT '1';
SELECT * FROM t1;
--connection server1
--echo server1
--echo [start server1]
--source include/start_mysqld.inc
--replace_result $s1_local_address s1_local_address
eval SET GLOBAL group_replication_local_address='$s1_local_address';
--replace_result $s1_seeds s1_seeds
eval SET GLOBAL group_replication_group_seeds='$s1_seeds';
eval SET GLOBAL group_replication_group_name='$group_replication_group_name';
--source include/start_group_replication.inc
connect (conn1_5_2,127.0.0.1,root,,test,$SERVER_MYPORT_1,);
connection conn1_5_2;
--echo [connect conn1_5_2]
SET SESSION group_replication_consistency='BEFORE';
SELECT * FROM t1;
UPDATE t1 SET c2=c1 WHERE c1=1;
disconnect conn1_5_2;
disconnect conn2_5_1;


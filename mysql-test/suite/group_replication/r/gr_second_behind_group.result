[connection server1]

####
# 0) The test requires four servers.
####

[connection server1]
include/start_and_bootstrap_group_replication.inc
[connection server2]
include/start_group_replication.inc
[connection server3]
include/start_group_replication.inc
[connection server4]
include/start_group_replication.inc
####
# 1) init test data.
####
[connection server1]
create table test.t1 (id int primary key);
SHOW GLOBAL STATUS LIKE "group_replication_second_behind_group";
Variable_name	Value
group_replication_second_behind_group	0
[connection server1]
[connection server4]
SHOW GLOBAL STATUS LIKE "group_replication_second_behind_group";
Variable_name	Value
group_replication_second_behind_group	0
####
# 2) Lock table and insert data. Unlock table after sleep, and check second_behind_group value.
####
[connection server2]
set global read_only = false;
lock tables test.t1 write;
[connection server1]
CREATE PROCEDURE insert_one_by_one()
BEGIN
DECLARE i INT DEFAULT 1;
WHILE i <= 1000 DO
INSERT INTO test.t1 VALUES (i);
SET i = i + 1;
END WHILE;
END
$
CALL insert_one_by_one();
truncate test.t1;
[connection server4]
SHOW GLOBAL STATUS LIKE "group_replication_second_behind_group";
Variable_name	Value
group_replication_second_behind_group	0
[connection server2]
unlock tables;
include/assert.inc [Check second_behind_group status success.]
select t.SECOND_BEHIND_GROUP > 3 and t.SECOND_BEHIND_GROUP < 100 from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID = @@server_uuid) t;
t.SECOND_BEHIND_GROUP > 3 and t.SECOND_BEHIND_GROUP < 100
1
select (select sum(SECOND_BEHIND_GROUP) from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID != @@server_uuid)) = 0;
(select sum(SECOND_BEHIND_GROUP) from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID != @@server_uuid)) = 0
1
####
# 3) Set replica_parallel_workers=0, repeat test;
####
[connection server3]
set global replica_parallel_workers=0;
Warnings:
Warning	1287	'0' is deprecated and will be removed in a future release. Please use 1 instead
include/stop_group_replication.inc
include/start_group_replication.inc
SHOW GLOBAL VARIABLES LIKE "replica_parallel_workers";
Variable_name	Value
replica_parallel_workers	0
set global read_only = false;
lock tables test.t1 write;
[connection server1]
CALL insert_one_by_one();
truncate test.t1;
[connection server3]
unlock tables;
include/assert.inc [Check second_behind_group status success.]
select t.SECOND_BEHIND_GROUP > 3 and t.SECOND_BEHIND_GROUP < 100 from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID = @@server_uuid) t;
t.SECOND_BEHIND_GROUP > 3 and t.SECOND_BEHIND_GROUP < 100
1
select (select sum(SECOND_BEHIND_GROUP) from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID != @@server_uuid)) = 0;
(select sum(SECOND_BEHIND_GROUP) from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID != @@server_uuid)) = 0
1

####
# 4) Stop Secondary and Arbitrator node MGR, Priamry node insert 1000 data. start MGR, check second_behind_group value when Secondary node recovering.
####

[connection server2]
include/stop_group_replication.inc
[connection server4]
include/stop_group_replication.inc
SHOW GLOBAL STATUS LIKE "group_replication_second_behind_group";
Variable_name	Value
group_replication_second_behind_group	0
[connection server1]
CALL insert_one_by_one();
truncate test.t1;
begin;
select * from test.t1 for update;
id
[connection server2]
start group_replication;
include/assert.inc [Check second_behind_group status success.]
select t.SECOND_BEHIND_GROUP > 3 and t.SECOND_BEHIND_GROUP < 100 from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID = @@server_uuid) t;
t.SECOND_BEHIND_GROUP > 3 and t.SECOND_BEHIND_GROUP < 100
1
select (select sum(SECOND_BEHIND_GROUP) from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID != @@server_uuid)) = 0;
(select sum(SECOND_BEHIND_GROUP) from (select SECOND_BEHIND_GROUP from performance_schema.replication_group_member_stats where MEMBER_ID != @@server_uuid)) = 0
1
SELECT member_state, member_role from performance_schema.replication_group_members WHERE MEMBER_ID = @@server_uuid;
member_state	member_role
RECOVERING	PRIMARY
rollback;
[connection server4]
start group_replication;
SHOW GLOBAL STATUS LIKE "group_replication_second_behind_group";
Variable_name	Value
group_replication_second_behind_group	0

####

set sql_mode=oracle;
CREATE or replace PROCEDURE p2() as
a1 int := 2;
c sys_refcursor;
begin
open c for select * from t1 where a=a1;
close c;
end;
$$
call p2;
drop PROCEDURE p2;
CREATE or replace PROCEDURE p3() as
cursor c is select * from t1 union select * from t2 where c>0;
begin
open c;
close c;
end;
$$
call p3;
drop PROCEDURE p3;
CREATE or replace PROCEDURE p4() as
c sys_refcursor;
str varchar(100) := 'select * from t1 union select * from t2 where c>0';
begin
open c for str;
close c;
end;
$$
call p4;
drop PROCEDURE p4;
CREATE or replace PROCEDURE p1() as
a int := 2;
begin
select * from t2 where c<a;
end;
$$
call p1;
c	d
drop PROCEDURE p1;
CREATE or replace function f1() return int is
result int;
begin
select b into result from t1 where a=2 limit 1;
return result;
END;
$$
select f1();
f1()
3
drop function f1;
CREATE or replace procedure ExecuteDDL(ddl_cmd varchar(500)) as
l_handle integer;
l_rows int;
BEGIN
l_handle := dbms_sql.open_cursor();
select l_handle;
call dbms_sql.parse(l_handle, ddl_cmd, 1);
l_rows:= dbms_sql_execute(l_handle);
call dbms_sql.close_cursor(l_handle);
end;
$$

[connect default]
SET @old_xa_detach_on_prepare=@@global.xa_detach_on_prepare;
SET GLOBAL xa_detach_on_prepare=OFF;
CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT);
[connect conn1]
XA START '1';
INSERT INTO t1 VALUES (1,1);
XA END '1';
XA PREPARE '1';
XA COMMIT '1';
SELECT * FROM t1;
c1	c2
1	1
[connect conn1]
XA START '2';
INSERT INTO t1 VALUES (2,2);
XA END '2';
XA COMMIT '2' ONE PHASE;
SELECT * FROM t1;

Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
CREATE TABLE DIC_PROD (
PROD_CD varchar(16) NOT NULL COMMENT '产品编码作为主键',
PROD_NAME varchar(128) DEFAULT NULL,
TYPE int DEFAULT NULL COMMENT '2:PSTN，1:ADSL，4:WLAN，5:IPTV 业务字典产品类型',
PROD_CLASS tinyint unsigned NOT NULL COMMENT '0:固话,1:ftth,2:LAN,3:ADSL,4:IPTV,5:WLAN',
DISP_ORDER int DEFAULT NULL,
DEL_FLAG int DEFAULT '0' COMMENT '0：否，1：是',
PROVINCE int DEFAULT NULL,
SHARDING_ID int DEFAULT NULL,
PRIMARY KEY (`PROD_CD`),
KEY idx_access_class (`PROD_CLASS`)
)  DEFAULT CHARSET=utf8mb3 COMMENT='产品编码表，各省不同的数据，通过province字段区分';
Warnings:
Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
SELECT 
DP.TYPE AS prodType,
WP.TIME_LIMIT AS timeLimit
FROM WO_WORK_ORDER WO LEFT JOIN WO_PROCESS WP ON WO.WO_ID=WP.WO_ID 
LEFT JOIN WO_REPAIR_EXT WRE ON WRE.WO_ID=WO.WO_ID 
LEFT JOIN DIC_PROD DP ON DP.PROD_CD=WO.PROD_CD 
LEFT JOIN WO_RES WR ON WR.WO_ID=WO.WO_ID 
WHERE WP.STATUS=1;
prodType	timeLimit
drop table WO_WORK_ORDER, WO_PROCESS, WO_REPAIR_EXT, DIC_PROD, WO_RES;

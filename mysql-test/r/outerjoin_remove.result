CREATE TABLE WO_WORK_ORDER (
WO_ID bigint NOT NULL AUTO_INCREMENT,
BUSI_TYPE int DEFAULT NULL COMMENT '1：装机，2：修机，5：性能工单,6:扩容工单,69:第三方装机，7:整治工单，9:智能组网延伸服务',
ORDER_TYPE int DEFAULT NULL COMMENT '业务字典：正常单，外堪单，投诉故障单69、第三方工单',
BUSI_NO varchar(32) DEFAULT NULL,
ACCOUNT varchar(32) DEFAULT NULL COMMENT '宽带账号',
PROVINCE int DEFAULT NULL,
CITY int DEFAULT NULL,
CUST_ORDER_CD varchar(64) DEFAULT NULL COMMENT '客户订单号',
ORDER_CD varchar(64) DEFAULT NULL COMMENT '服务定单号',
WORK_ORDER_SN varchar(64) DEFAULT NULL COMMENT '工单流水号，装存iom的工单流水号，修存客服的工单流水号',
URGENCY int DEFAULT NULL COMMENT '业务字典',
CONTACT_MAN varchar(256) DEFAULT NULL COMMENT '装机：从客户信息读到此处，\n 修机：申告时客户留的联系人和联系电话，若没有，从客户信息中取',
CONTACT_MAN_TEL varchar(48) DEFAULT NULL COMMENT '同联系人',
PROD_CD varchar(16) DEFAULT NULL COMMENT '1000:语音遥控器、279:IPTV、2795:宽带+IPTV、40:宽带、4006:多路固话宽带、4007:多路固话、4003:TV+、4004:宽带+TV+、5955:IMS固话、5959:固话自动回单、888:智能组网前置、2170:终端更换、1700:预受理、3011:千兆光猫更换、4005:魔百和维修后置更换,3012:普通光猫更换,886:组网施工,887:智能组网后置,888:智能组网前置,889:智能组网勘测,3300:平安乡村,3200:爱心套装,4300:单点扩容,1050:光改,3016:云打印机(政企)',
PROD_ACTION varchar(24) DEFAULT NULL,
SERVICE_CD varchar(16) DEFAULT NULL,
SERVICE_NAME varchar(32) DEFAULT NULL,
WORK_ACTION varchar(22) DEFAULT NULL COMMENT '1:装 2:拆 3:移 42:装维移机拆 69:第三方装机 （4：客服系统受理投诉单 21：第三方投诉单）(6:PON口弱光 7：ONU弱光 8：质差用户 9：质差ONU/ONT 10：质差PON口 11：OLT高流量 13:分支光纤断PON口聚合派单 14:质差小区,24: OLT上行收光弱光（派单到自维）,25：高频故障（派单到自维），26：千兆接入能力预警（派单到自维）,29:督办提醒工单（派单到自维）)12：扩容,80：智能组网前置,81：智能组网后置,82：组网勘测,83:终端更换,84:预受理,85:千兆光猫更换,86:魔百和维修后置更换,79:普通光猫更换,78:组网施工,77:语音遥控器,76:平安乡村,75:爱心套装,43:单点扩容,73:光改',
WORK_ADDRESS varchar(256) DEFAULT NULL,
STD_ADDR_ID varchar(128) DEFAULT NULL,
STD_ADDR_NAME varchar(256) DEFAULT NULL COMMENT '标准地址名称',
EXCH_CD varchar(256) DEFAULT NULL COMMENT '用户局向编码',
SITE_CD varchar(16) DEFAULT NULL COMMENT '局站编码',
SITE_NAME varchar(64) DEFAULT NULL COMMENT '局站名称',
ACCEPT_MAN varchar(32) DEFAULT NULL COMMENT '受理人名称',
ACCEPT_DEP varchar(64) DEFAULT NULL COMMENT '受理人部门',
ACCEPT_TIME datetime DEFAULT NULL COMMENT '受理时间',
CONTENT varchar(4000) DEFAULT NULL COMMENT '障碍现象描述，开通单受理备注',
DEL_FLAG int DEFAULT '0' COMMENT '0：否，1：删除 2、撤单 3、退单',
CREATE_TIME datetime DEFAULT NULL COMMENT '创建时间',
SHARDING_ID int DEFAULT NULL COMMENT '用于cobar分库字段，填省份编码',
PRIMARY KEY (`WO_ID`),
KEY idx_order_cd (`ORDER_CD`),
KEY BUSI_NO (`BUSI_NO`),
KEY ACCEPT_TIME (`ACCEPT_TIME`),
KEY CUST_ORDER_CD (`CUST_ORDER_CD`),
KEY idx_wo_sn (`WORK_ORDER_SN`),
KEY idx_accept_man (`ACCEPT_MAN`),
KEY woAction (`WORK_ACTION`),
KEY create_time (`CREATE_TIME`),
KEY delflag (`DEL_FLAG`),
KEY PROD_CD (`PROD_CD`),
KEY worksn (`WORK_ORDER_SN`),
KEY ind_busi_type (`BUSI_TYPE`),
KEY stand_addr_id (`STD_ADDR_ID`)
)  AUTO_INCREMENT=7735 DEFAULT CHARSET=utf8mb3;

Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
Warning	1831	Duplicate index 'worksn' defined on the table 'test.WO_WORK_ORDER'. This is deprecated and will be disallowed in a future release.
CREATE TABLE WO_PROCESS (
WO_ID bigint NOT NULL AUTO_INCREMENT,
WO_CD varchar(32) DEFAULT NULL,
PROCESSINSTID bigint DEFAULT NULL,
STATUS int DEFAULT NULL COMMENT 'workOrder.status字典表',
BOOK_ID bigint DEFAULT NULL COMMENT '预约表主键',
BOOK_FLAG int DEFAULT '1' COMMENT '1：系统补约（未预约），2：预约，3：改约',
READ_FLAG int DEFAULT '0',
ASSIGN_TO_ORGID bigint DEFAULT NULL,
ASSIGN_TO_ORGSEQ varchar(128) DEFAULT NULL COMMENT '最小一级机构seq',
BELONG_MAN varchar(32) DEFAULT NULL,
DEAL_USERID varchar(32) DEFAULT NULL,
LAST_ASSIGN_ID bigint DEFAULT NULL,
LAST_DELAY_ID bigint DEFAULT NULL,
TIME_LIMIT int DEFAULT NULL,
HASTEN_CUST_CNT int DEFAULT '0' COMMENT '可认为是重复申告',
SHARDING_ID int DEFAULT NULL COMMENT '用于cobar分库字段，填省份编码',
OPER_ID varchar(30) DEFAULT NULL,
ORDER_STATUS int DEFAULT NULL,
PRIMARY KEY (`WO_ID`),
UNIQUE KEY idx_instid (`PROCESSINSTID`),
KEY STATUS (`STATUS`),
KEY idx_ASSIGN_TO_ORGID (`ASSIGN_TO_ORGID`),
KEY idx_ASSIGN_TO_ORGSEQ (`ASSIGN_TO_ORGSEQ`),
KEY idx_wop_deal_userid (`DEAL_USERID`),
KEY idx_book_id (`BOOK_ID`),
KEY idx_book_flag (`BOOK_FLAG`),
KEY idx_delay_id (`LAST_DELAY_ID`)
)  AUTO_INCREMENT=7735 DEFAULT CHARSET=utf8mb3;

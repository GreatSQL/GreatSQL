Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
CREATE TABLE WO_REPAIR_EXT (
WO_ID bigint NOT NULL AUTO_INCREMENT,
CALL_TEL varchar(16) DEFAULT NULL COMMENT '用户申告时使用的电话号码',
OCCUR_TIME datetime DEFAULT NULL,
PHEN_ID int DEFAULT NULL,
PRETREATMENT varchar(1024) DEFAULT NULL COMMENT '来自预处理系统的单子，需要显示预处理信息，供排障过程参考。',
LAST_OCCUR_GAP int DEFAULT NULL COMMENT '再次发生间隔',
SHARDING_ID int DEFAULT NULL COMMENT '用于cobar分库字段，填省份编码',
FAULT_TYPE varchar(128) DEFAULT NULL COMMENT '故障类型',
BR_CUSTOM_TYPE varchar(64) DEFAULT NULL COMMENT '用户类型',
BR_CUSTOMR_EQUIRE varchar(256) DEFAULT NULL COMMENT '用户要求',
PHEN_ID_NAME varchar(256) DEFAULT NULL COMMENT '问题类型描述',
PRIORITY varchar(32) DEFAULT NULL COMMENT '客户星级',
ACCEPT_NAME varchar(32) DEFAULT NULL COMMENT '申告人',
IF_UP_COMPLAINT varchar(8) DEFAULT NULL COMMENT '是否升级投诉',
ACCEPT_TEL varchar(32) DEFAULT NULL COMMENT '受理人电话',
TERMINAL_TYPE varchar(128) DEFAULT NULL COMMENT '终端描述',
COMPLAINT_DESC varchar(2000) DEFAULT NULL COMMENT '投诉内容，用户描述',
SVC_TYPE varchar(64) DEFAULT NULL COMMENT '服务标识，集团分类',
COMPLAINT_TIME datetime DEFAULT NULL COMMENT '投诉时间',
PLAN_FINAL_TIME datetime DEFAULT NULL COMMENT '计划结束时间',
COMPLAINT_TYPE varchar(256) DEFAULT NULL COMMENT '投诉分类（省）',
WACCT_NO varchar(16) DEFAULT NULL COMMENT 'RADIUS宽带主帐号',
CUST_EXPECTE varchar(256) DEFAULT NULL COMMENT '客户预期处理结果',
ACCESS_TYPE varchar(16) DEFAULT NULL COMMENT '接入方式',
IS_VISIT varchar(16) DEFAULT NULL COMMENT '用户回访',
PRIMARY KEY (`WO_ID`)
)  AUTO_INCREMENT=31611982 DEFAULT CHARSET=utf8mb3;

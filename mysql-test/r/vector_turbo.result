create table test1(a float, b float, c float);
insert into test1 values(1.1, 2.8, 3.9);
insert into test1 values(2.1, null, 3.9);
insert into test1 values(2.2, 3.7, 4.0);
insert into test1 values(3.2, 4.7, null);
insert into test1 values(3.3, 4.6, 5.1);
insert into test1 values(null, 5.6, 6.1);
insert into test1 values(4.4, 5.5, 6.2);
select from_vector(to_vector(concat('[',a,',',b,']'))) x, from_vector(to_vector(concat('[',b,',',c,']'))) y, from_vector(to_vector(concat('[',c,',',a,']'))) z from test1;
x	y	z
[1.10000e+00,2.80000e+00]	[2.80000e+00,3.90000e+00]	[3.90000e+00,1.10000e+00]
NULL	NULL	[3.90000e+00,2.10000e+00]
[2.20000e+00,3.70000e+00]	[3.70000e+00,4.00000e+00]	[4.00000e+00,2.20000e+00]
[3.20000e+00,4.70000e+00]	NULL	NULL
[3.30000e+00,4.60000e+00]	[4.60000e+00,5.10000e+00]	[5.10000e+00,3.30000e+00]
NULL	[5.60000e+00,6.10000e+00]	NULL
[4.40000e+00,5.50000e+00]	[5.50000e+00,6.20000e+00]	[6.20000e+00,4.40000e+00]
explain format=tree select from_vector(to_vector(concat('[',a,',',b,']'))) x, from_vector(to_vector(concat('[',b,',',c,']'))) y, from_vector(to_vector(concat('[',c,',',a,']'))) z from test1;
EXPLAIN
-> Turbo scan
    -> projection: (x, y, z)  (...)
        -> projection: (CAST(a AS VARCHAR), CAST(b AS VARCHAR), CAST(c AS VARCHAR))  (...)
            -> Table scan on test1, column(a,b,c)  (...)


set turbo_enable=off;

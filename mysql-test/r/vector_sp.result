#
# type: vector without indicate length, default len is 2048
# 
SET sql_mode=DEFAULT|
CREATE or replace PROCEDURE p1(str vector(16383)) BEGIN DECLARE x vector(16383); SET x = str; SELECT vector_dim(x); END;|
CREATE or replace PROCEDURE p2(str vector) BEGIN DECLARE x vector(16383); SET x = str; SELECT vector_dim(x); END;|
CREATE or replace PROCEDURE p3(str vector(16383)) BEGIN DECLARE x vector; SET x = str; SELECT vector_dim(x); END;|
CALL p1(to_vector('[1,2]'))|
vector_dim(x)
2
set @x = concat('[', repeat('1,', 2047), 42, ']') |
call p2(to_vector(@x))|
vector_dim(x)
2048
call p3(to_vector(@x))|
vector_dim(x)
2048
set @x = concat('[', repeat('1,', 2048), 42, ']') |
call p2(to_vector(@x))|
ERROR 22001: Data too long for column 'str' at row 1
call p3(to_vector(@x))|
ERROR 22001: Data too long for column 'x' at row 1
DROP PROCEDURE p1|
DROP PROCEDURE p2|
DROP PROCEDURE p3|

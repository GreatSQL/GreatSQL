# 1. Test New GTID FUNCTION GTID_COUNT() and GTID_SUB();
select gtid_sub('a10e77bb-8228-11f0-923b-0242ac120002:2-6', 'a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55');
gtid_sub('a10e77bb-8228-11f0-923b-0242ac120002:2-6', 'a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55')
58 ~ a10e77bb-8228-11f0-923b-0242ac120002:7-10,
c09701b4-8250-11f0-9165-0242ac120002:2-55
select gtid_sub('a10e77bb-8228-11f0-923b-0242ac120002:1-6', 'a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55');
gtid_sub('a10e77bb-8228-11f0-923b-0242ac120002:1-6', 'a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55')
NULL
select gtid_sub('a10e77bb-8228-11f0-923b-0242ac120002:2-6', '5523ad82-825d-11f0-90b3-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55');
gtid_sub('a10e77bb-8228-11f0-923b-0242ac120002:2-6', '5523ad82-825d-11f0-90b3-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55')

# 2. test user variables
SET @a='a10e77bb-8228-11f0-923b-0242ac120002:2-6', @b='a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10, c09701b4-8250-11f0-9165-0242ac120002:2-55';
select gtid_sub(@a,@b);
gtid_sub(@a,@b)
58 ~ a10e77bb-8228-11f0-923b-0242ac120002:7-10,
c09701b4-8250-11f0-9165-0242ac120002:2-55
select gtid_count(@b);
gtid_count(@b)
63
# 3. test error GTID format
select gtid_count('a10e77bb-8228-11f0-923b-0242ac120002:1-6,3-20');
ERROR HY000: Malformed GTID set specification 'a10e77bb-8228-11f0-923b-0242ac120002:1-6,3-20'.
select gtid_sub('a10e77bb-8228-11f0-0242ac120002:2-6, c09701b4-8250-11f0-9165-0242ac120002', 'a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10,c09701b4-8250-11f0-9165-0242ac120002:2-55');
ERROR HY000: Malformed GTID set specification 'a10e77bb-8228-11f0-0242ac120002:2-6, c09701b4-8250-11f0-9165-0242ac120002'.
select gtid_sub('a10e77bb-8228-11f0-0242ac120002:2-6, c09701b4-8250-11f0-9165-0242ac120002', 'a10e77bb-8228-11f0-923b-0242ac120002:2-4:3-10:c09701b4-8250-11f0-9165-0242ac120002:2-55');
ERROR HY000: Malformed GTID set specification 'a10e77bb-8228-11f0-0242ac120002:2-6, c09701b4-8250-11f0-9165-0242ac120002'.
# 4. test function GTID_POSITION_IN_BINLOG()
create database db1;
create database db2;
create database db3;
select GTID_POSITION_IN_BINLOG('GTID', true) as gtid_pos;
gtid_pos
./binlog.000001~position:417~transaction_length:182
flush binary logs;
create database db4;
create database db5;
create database db6;
select GTID_POSITION_IN_BINLOG('GTID', false) as gtid_pos;
gtid_pos
./binlog.000001
SET @b='GTID';
select GTID_POSITION_IN_BINLOG(@b, false) as gtid_pos;
gtid_pos
./binlog.000002
select GTID_POSITION_IN_BINLOG(@b, true) as gtid_pos;
gtid_pos
./binlog.000002~position:639~transaction_length:182
select GTID_POSITION_IN_BINLOG('GTID_SET', true) as gtid_pos;
gtid_pos
NULL
select GTID_POSITION_IN_BINLOG('a10e77bb-8228-11f0-923b-0242ac120002:3', false) as gtid_pos;
gtid_pos
NULL
select GTID_POSITION_IN_BINLOG('a10e77bb-8228-11f0-0242ac120002:2', false) as gtid_pos;
ERROR HY000: Malformed GTID set specification 'a10e77bb-8228-11f0-0242ac120002:2'.
drop database db1;
drop database db2;
drop database db3;
drop database db4;
drop database db5;
drop database db6;
